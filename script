local VK = {
    Space = 0x20, LeftShift = 0xA0, Return = 0x0D, Escape = 0x1B, Backspace = 0x08,
    BackSlash = 0xDC, Tab = 0x09, LeftControl = 0xA2, RightControl = 0xA3,
}

local function vkOf(keyCode)
    local name = keyCode and keyCode.Name
    if not name then return nil end
    if VK[name] then return VK[name] end
    local digit = name:match("^F(%d+)$")
    if digit then return 0x70 + tonumber(digit) - 1 end
    if #name == 1 then
        local byte = string.byte(name:upper())
        if (byte >= 65 and byte <= 90) or (byte >= 48 and byte <= 57) then return byte end
    end
    return nil
end

local HeldKeys = {}

local function keyDown(keyCode)
    local vk = vkOf(keyCode)
    if not vk then return false end
    HeldKeys[vk] = keyCode
    if caps.keypress then
        local ok = pcall(caps.keypress, vk)
        if ok then return true end
    end
    if vimKey(keyCode, true) then return true end
    HeldKeys[vk] = nil
    return false
end

local function keyUp(keyCode)
    local vk = vkOf(keyCode)
    if not vk then return false end
    HeldKeys[vk] = nil
    if caps.keyrelease then pcall(caps.keyrelease, vk) end
    vimKey(keyCode, false)
    return true
end

