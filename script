local function statusText()
    local lines = {}
    local function add(label, fn)
        local ok, value = pcall(fn)
        if ok then
            if value ~= nil then lines[#lines + 1] = tostring(value) end
        else
            lines[#lines + 1] = label .. ": unavailable"
        end
    end

    add("state", function()
        return (S.running and "RUNNING" or "STOPPED") .. "   " .. tostring(S.state or "idle")
    end)
    add("place", function()
        return "place: " .. currentKind() .. "   round: " .. tostring(S.roundType or "-")
    end)
    add("target", function()
        local target = S.target
        return "target: " .. (target and tostring(target.name) or "none")
            .. "   dist: " .. (S.dist and string.format("%.0f", S.dist) or "-")
    end)
    add("kills", function()
        return string.format("kills: %d   slashes: %d   hits(confirmed): %d   pulls: %d   %.1f k/min",
            S.kills or 0, S.swings or 0, S.hits or 0, S.pulls or 0,
            (S.kills or 0) / math.max(1, (clock() - (S.startedAt or clock())) / 60))
    end)
    add("registers", function()
        local M = S.meter or {}
        local swings = M.swings or S.swings or 0
        local regs = M.registers or S.registers or 0
        local kills = S.kills or 0
        local ratio = swings > 0 and regs / swings or 0
        local perKill = kills > 0 and swings / kills or 0
        local diag
        if cfg.countRegisters ~= true then
            diag = "register counter OFF"
        elseif HitSignal.registerAvailable ~= true then
            diag = "register counter unavailable: " .. tostring(HitSignal.registerReason or "?")
        elseif ratio < 0.5 then
            diag = "diagnosis: blade not overlapping nape (registers/swing < 0.5)"
        elseif perKill > 30 and ratio >= 0.8 then
            diag = "diagnosis: overlap good; low damage/speed"
        else
            diag = string.format("diagnosis: overlap %.2f", ratio)
        end
        return string.format("registers: %d   registers/swing: %.2f   swings/kill: %.1f   %s",
            regs, ratio, perKill, diag)
    end)
    add("damage", function()
        local M = S.meter or {}
        return string.format("damage: %.1f total   %.2f/swing   last hit: %.1f   speed@swing: last %.0f avg10 %.0f",
            M.damage or 0, (M.damage or 0) / math.max(1, M.swings or 0),
            M.lastDamage or 0, M.lastSpeed or 0, M.avgSpeed or 0)
    end)
    add("drift", function()
        return string.format("drift: max %.1f last %.1f   joints: %d off / %d on   method: %s",
            S.drift or 0, S.lastDrift or 0, S.jointsOff or 0, S.jointsOn or 0,
            tostring(S.pullMethod or "-"))
    end)
    add("alive", function()
        return string.format("alive: %s   gas: %s   sets: %s   blades: %s   rate: %.1f/s",
            tostring(S.alive or "-"), S.gas and (tostring(S.gas) .. "%") or "-",
            tostring(S.refills or "-"), S.bladesBroken and "broken" or "ok", S.rate or 0)
    end)
    add("durability", function()
        return string.format("durability: X=%s Y=%s -> %s (%s)   HUD sets \"%s\" (%s) attr %s",
            S.durabilityX ~= nil and string.format("%.3f", S.durabilityX) or "-",
            S.durabilityY ~= nil and string.format("%.3f", S.durabilityY) or "-",
            S.durability ~= nil and string.format("%.3f", S.durability) or "-",
            tostring(S.durabilitySource or "-"), tostring(S.refillsText or "-"),
            S.refills ~= nil and tostring(S.refills) or "-",
            S.refillsAttr ~= nil and tostring(S.refillsAttr) or "-")
    end)
    add("refill-decision", function()
        return "refill decision: " .. tostring(Refill.decision or "idle")
            .. "   why: " .. tostring(Refill.why or "-")
    end)
    add("pull", function()
        return "pull: " .. tostring(S.pullMethod or "off")
            .. "   ran: " .. tostring(S.pullRan == true)
            .. "   mode: " .. tostring(cfg.pullDetach)
            .. "   wait: " .. tostring(cfg.pullWait)
            .. "   noCollide: " .. tostring(cfg.pullNoCollide == true)
            .. "   why: " .. tostring(S.pullMsg or "-")
    end)
    add("path", function()
        return "path: locked=" .. tostring(Path.locked or "none")
            .. string.format("   cadence %.2fs", tonumber(cfg.swingInterval) or 0.20)
            .. "   " .. Path.summary()
            .. (Path.msg and ("   " .. tostring(Path.msg)) or "")
    end)
    add("pin", function()
        return string.format("pin: %s   drift %.1f studs   msg: %s",
            Pin.active and "ON" or "OFF", S.pinDrift or 0, tostring(S.pinMsg or "-"))
    end)
    add("hit-signal", function()
        return "hit signal: " .. tostring(cfg.hitSignal or "auto")
            .. "   watchdog: " .. tostring(S.watchdogMsg or "ok")
            .. string.format("   no-hit swings: %d/%d", S.swingsNoHit or 0, cfg.watchdogSwings or 30)
    end)
    add("retries", function()
        if S.retries and S.retries > 0 then return "retries: " .. tostring(S.retries) end
        return nil
    end)
    add("refill", function()
        if not (S.refillMsg or S.refilling or S.reloading) then return nil end
        return string.format(
            "refill: %s   try %d   method %s   hold %.1fs   sets %s/%s   dur %s",
            tostring(S.refillMsg or Refill.decision or "-"), Refill.attempts or 0,
            tostring(Refill.lastMethod or "-"), Refill.lastHold or 0,
            tostring(S.refills or "-"), tostring(Refill.maxSets or 3),
            S.durability and string.format("%.2f", S.durability) or "-")
    end)
    add("auto", function() return AutoExec.describe() end)
    add("autostart", function() return "autostart: " .. BOOT.describe() end)
    add("auto-note", function()
        if S.autoMsg then return "auto note: " .. tostring(S.autoMsg) end
        return nil
    end)
    lines[#lines + 1] = "error: " .. tostring(S.err or BOOT.lastError or "none")
    lines[#lines + 1] = "last exit: " .. tostring(S.lastExit or "none")
    return table.concat(lines, "\n")
end


refreshStatus = function()
    local ok, text = pcall(statusText)
    if not ok then
        setError("statusText", text)
        text = "panel error: " .. tostring(text)
            .. "\nauto: unavailable\nautostart: unavailable\nerror: " .. tostring(text)
    end
    pcall(function()
        if UI.status and UI.status.Parent then UI.status.Text = text end
    end)
end

