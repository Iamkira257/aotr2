local function shown(instance)
    -- Results panels are never destroyed, only hidden, so a stale panel in the
    -- lobby must not count as a result. Walk Visible and Enabled up the tree.
    local node = instance
    while node and node ~= game do
        local okVisible, visible = pcall(function() return node.Visible end)
        if okVisible and visible == false then return false end
        local okEnabled, enabled = pcall(function() return node.Enabled end)
        if okEnabled and enabled == false then return false end
        node = node.Parent
    end
    return true
end

local function resultsSignature()
    -- The lobby keeps the last round's labels, and a stale panel there was being
    -- read as a live result: fastTick then stood still ("results screen") and
    -- auto-retry pressed Retry, which is what sent the character back to town.
    -- Only a real round place may produce a signature. Same guard as the delta build.
    if currentKind() ~= "mission" then
        S.results = false
        return nil
    end
    local okType, missionType = pcall(function() return workspace:GetAttribute("Type") end)
    if not okType or missionType == nil then return nil end
    local flatType = normText(missionType)
    if flatType == "" or flatType == "none" or flatType == "lobby" then return nil end
    local info = resultsInfo()
    if not info or not shown(info) then return nil end
    local stateLabel = info:FindFirstChild("State")
    if not stateLabel then return nil end
    local ok, text = pcall(function() return stateLabel.Text end)
    if not ok or type(text) ~= "string" then return nil end
    local upper = string.upper(text)
    if not string.find(upper, "COMPLETED", 1, true) and not string.find(upper, "FAILED", 1, true) then
        return nil
    end
    local parts = { upper }
    local main = info:FindFirstChild("Main")
    local stats = main and main:FindFirstChild("Stats")
    for _, name in ipairs({ "Time_Taken", "Damage", "Kills", "Crits" }) do
        local row = stats and stats:FindFirstChild(name)
        local amount = row and row:FindFirstChild("Amount")
        local okAmount, value = pcall(function() return amount.Text end)
        parts[#parts + 1] = tostring(okAmount and value or "?")
    end
    local okSeconds, seconds = pcall(function() return workspace:GetAttribute("Seconds") end)
    parts[#parts + 1] = tostring(okSeconds and seconds or "?")
    return table.concat(parts, "|")
end
