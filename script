--============================================================================
--  FLIGHT RECORDER
--============================================================================
local Exit = { frames = {}, max = 40, started = false, token = 0 }

function Exit.stop()
    Exit.token = (Exit.token or 0) + 1
    Exit.started = false
end

function Exit.attr(name)
    local ok, value = pcall(function() return workspace:GetAttribute(name) end)
    if ok then return value end
    return nil
end

function Exit.clean(value)
    if value == nil then return "-" end
    local text = tostring(value)
    return (string.gsub(text, "[|\r\n]", "/"))
end

function Exit.aliveTitans()
    local folder = workspace:FindFirstChild("Titans")
    if not folder then return 0 end
    local count = 0
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and not dead(model) then count = count + 1 end
    end
    return count
end

function Exit.playerHealth()
    local _, _, humanoid = myChar()
    if not humanoid then return "-" end
    local ok, health = pcall(function() return humanoid.Health, humanoid.MaxHealth end)
    if not ok or health == nil then return "-" end
    local okMax, maximum = pcall(function() return humanoid.MaxHealth end)
    return string.format("%s/%s", tostring(math.floor(tonumber(health) or 0)),
        tostring(math.floor(tonumber(okMax and maximum or 0) or 0)))
end

function Exit.retryState()
    return string.format("tries=%d method=%s result=%s label=%s", Retry.tries or 0,
        Exit.clean(Retry.lastMethod), Exit.clean(Retry.lastResult), Exit.clean(Retry.lastLabel))
end

function Exit.snapshot()
    local target = S.target
    local players = Exit.attr("Player_Count")
    if players == nil then players = #Players:GetPlayers() end
    return string.format(
        "%s kind=%s type=%s obj=%s sec=%s players=%s alive=%d | state=%s target=%s noHit=%s wd=%s "
            .. "path=%s pin=%s gas=%s sets=%s blades=%s | results=%s%s retry=%s | auto=%s err=%s hp=%s",
        os.date("%H:%M:%S"), Exit.clean(currentKind()), Exit.clean(Exit.attr("Type")),
        Exit.clean(Exit.attr("Objective")), Exit.clean(Exit.attr("Seconds")), Exit.clean(players),
        Exit.aliveTitans(), Exit.clean(S.state), Exit.clean(target and target.name or "none"),
        tostring(S.swingsNoHit or 0), tostring(S.watchdogStage or 0),
        Exit.clean(Path.locked), Pin.active and "ON" or "OFF", Exit.clean(S.gas),
        Exit.clean(S.refills), S.bladesBroken and "broken" or "ok",
        tostring(S.results == true), S.resultsAtText and ("@" .. S.resultsAtText) or "",
        Exit.retryState(), Exit.clean(S.autoMsg), Exit.clean(S.err), Exit.playerHealth())
end

function Exit.bottom(count)
    local lines = {}
    local from = math.max(1, #Exit.frames - (count or 10) + 1)
    for index = from, #Exit.frames do lines[#lines + 1] = Exit.frames[index] end
    return lines
end

function Exit.lastText(count)
    return table.concat(Exit.bottom(count or Exit.max), "\n")
end

function Exit.copyFlight(count)
    local text = Exit.lastText(count or Exit.max)
    local copied = false
    if type(setclipboard) == "function" then
        copied = pcall(setclipboard, text)
    end
    if not copied and caps.writefile then
        pcall(writefile, "aotr_flight_last40.txt", text)
    end
    return text, copied
end

function Exit.writeLast(tag, detail)
    local stamp = os.date("%H:%M:%S")
    local lines = {
        "AOTR internal v" .. VERSION .. " exit recorder " .. os.date("%Y-%m-%d %H:%M:%S"),
        "tag: " .. tostring(tag),
        "detail: " .. Exit.clean(detail),
        "last 10 flight entries:",
    }
    local recent = Exit.bottom(10)
    if #recent == 0 then
        local okSnap, line = pcall(Exit.snapshot)
        recent = { okSnap and line or ("snapshot error: " .. tostring(line)) }
    end
    for _, line in ipairs(recent) do lines[#lines + 1] = line end
    local all = Exit.bottom(Exit.max)
    if #all > #recent then
        lines[#lines + 1] = "last " .. tostring(#all) .. " flight entries:"
        for _, line in ipairs(all) do lines[#lines + 1] = line end
    end
    local body = table.concat(lines, "\n")
    S.lastExit = tostring(tag) .. " at " .. stamp .. " (" .. Exit.clean(detail) .. ")"
    print(body)
    if caps.writefile then pcall(writefile, "aotr_lastexit.txt", body) end
    return body
end

function Exit.results(signature)
    S.resultsAt = clock()
    S.resultsAtText = os.date("%H:%M:%S")
    S.autoMsg = "results screen at " .. S.resultsAtText
    say(S.autoMsg)
    Exit.frames[#Exit.frames + 1] = "RESULTS " .. S.resultsAtText .. " " .. Exit.clean(signature)
    while #Exit.frames > Exit.max do table.remove(Exit.frames, 1) end
    if caps.writefile then pcall(writefile, "aotr_flight.log", table.concat(Exit.frames, "\n")) end
end

function Exit.markGame(source, detail)
    local tag = "NOT SCRIPT-INITIATED"
    local text = tostring(source) .. ": " .. tostring(detail or "")
    if S.gameExitAt and clock() - S.gameExitAt <= 3 and S.gameExitText then
        text = S.gameExitText .. " | " .. text
    end
    S.gameExitAt, S.gameExitText = clock(), text
    S.autoMsg = tag .. " (" .. tostring(source) .. ")"
    pcall(Exit.writeLast, tag, text)
    say("[exit] " .. tag .. " " .. tostring(source) .. ": " .. tostring(detail or ""))
end

function Exit.start()
    if Exit.started then return true end
    Exit.started = true
    Exit.token = (Exit.token or 0) + 1
    local token = Exit.token
    local okSnap, first = pcall(Exit.snapshot)
    Exit.frames = { okSnap and first or ("snapshot error: " .. tostring(first)) }
    if caps.writefile then
        pcall(writefile, "aotr_flight.log", table.concat(Exit.frames, "\n"))
    end
    safeSpawn(function()
        local lastKind = currentKind()
        while Exit.token == token do
            task.wait(2)
            local kind = currentKind()
            if kind ~= lastKind then
                if lastKind == "mission" and (kind == "lobby" or kind == "menu" or kind == "trade") then
                    Exit.markGame("place change", lastKind .. " -> " .. kind)
                end
                lastKind = kind
            end
            local ok, line = pcall(Exit.snapshot)
            Exit.frames[#Exit.frames + 1] = ok and line or ("snapshot error: " .. tostring(line))
            while #Exit.frames > Exit.max do table.remove(Exit.frames, 1) end
            if caps.writefile then pcall(writefile, "aotr_flight.log", table.concat(Exit.frames, "\n")) end
        end
    end)
    pcall(function()
        lp.OnTeleport:Connect(safe(function(teleportType, placeId, spawnName)
            Exit.markGame("lp.OnTeleport", tostring(teleportType) .. " place=" .. tostring(placeId)
                .. " spawn=" .. tostring(spawnName))
        end, "connect"))
    end)
    pcall(function()
        local service = game:GetService("TeleportService")
        service.TeleportInitFailed:Connect(safe(function(player, result, message)
            if player ~= nil and player ~= lp then return end
            Exit.markGame("TeleportInitFailed", tostring(result) .. " " .. tostring(message))
        end, "connect"))
    end)
    pcall(function()
        local gui = game:GetService("GuiService")
        if gui and gui.ErrorMessageChanged then
            gui.ErrorMessageChanged:Connect(safe(function(message)
                if type(message) == "string" and message ~= "" then
                    Exit.markGame("GuiService.ErrorMessageChanged", message)
                end
            end, "connect"))
        end
    end)
    return true
end

-- Retry rungs, rotated in this order until the results screen is gone. Every
-- attempt is re-verified; firing a signal is not treated as success.
local RETRY_METHODS = { "connections", "input", "gamepad" }

local function retryAnchors()
    local playerGui = getPlayerGui()
    local interface = playerGui and playerGui:FindFirstChild("Interface")
    local rewards = interface and interface:FindFirstChild("Rewards")
    local scope = rewards or playerGui
    local anchors = {}
    if not scope then return anchors end
    for _, instance in ipairs(scope:GetDescendants()) do
        local okLabel, isLabel = pcall(function()
            return instance:IsA("TextLabel") or instance:IsA("TextButton")
        end)
        if okLabel and isLabel and guiVisible(instance) and not isOurs(instance) then
            local okText, text = pcall(function() return instance.Text end)
            if okText and type(text) == "string" then
                local flat = normText(text)
                if string.find(flat, "retry", 1, true)
                    and not string.find(flat, "leave", 1, true)
                    and not string.find(flat, "modif", 1, true) then
                    anchors[#anchors + 1] = instance
                end
            end
        end
    end
    return anchors
end

local function retryCandidates()
    local playerGui = getPlayerGui()
    local interface = playerGui and playerGui:FindFirstChild("Interface")
    local rewards = interface and interface:FindFirstChild("Rewards")
    local found, seen = {}, {}
    local function collect(scope)
        for _, button in ipairs(GuiAuto.findAll({ "retry", "again" }, scope, { "leave", "modify" })) do
            if not seen[button] then
                seen[button] = true
                found[#found + 1] = button
            end
        end
    end
    if rewards then collect(rewards) end
    collect(nil)
    return found
end

-- What a hand click actually hits at the visible RETRY text. The clickable
-- surface is often a bare overlay with no text, so matching button text alone
-- can land on a decorative duplicate that does nothing.
local function retryTargets()
    local targets, seen = {}, {}
    local function add(instance)
        if not instance or seen[instance] then return end
        local ok, isButton = pcall(function() return instance:IsA("GuiButton") end)
        if ok and isButton and not isOurs(instance) then
            seen[instance] = true
            targets[#targets + 1] = instance
        end
    end
    for _, anchor in ipairs(retryAnchors()) do
        local point = GuiAuto.centre(anchor)
        if point then
            local top = GuiAuto.topAt(point.X, point.Y)
            if top and not GuiAuto.matches(top, { "leave", "modif", "back", "close" }) then
                add(top)
            end
        end
        add(anchor)
    end
    for _, button in ipairs(retryCandidates()) do
        local reached = GuiAuto.hits(button)
        if reached then add(button) end
    end
    return targets
end

local function retryButton()
    return retryTargets()[1]
end

local function retryLabel(button)
    if not button then return "-" end
    local text = ""
    local ok, value = pcall(function() return button.Text end)
    if ok and type(value) == "string" then text = value end
    if text == "" then
        local okChild, child = pcall(function() return button:FindFirstChildWhichIsA("TextLabel", true) end)
        if okChild and child then
            local okText, childText = pcall(function() return child.Text end)
            if okText and type(childText) == "string" then text = childText end
        end
    end
    text = (string.gsub(tostring(text), "[\r\n]+", " "))
    if #text > 22 then text = string.sub(text, 1, 22) end
    return text ~= "" and text or "-"
end

-- A real InputObject cannot be constructed from a script, so the handler gets a
-- table carrying the fields a click handler reads; a bare call is retried when
-- that throws.
local function retryInput(button)
    local point = GuiAuto.centre(button)
    local position = point and Vector3.new(point.X, point.Y, 0) or Vector3.new(0, 0, 0)
    return {
        UserInputType = Enum.UserInputType.MouseButton1,
        UserInputState = Enum.UserInputState.Begin,
        KeyCode = Enum.KeyCode.Unknown,
        Position = position,
        Delta = Vector3.new(0, 0, 0),
    }
end

local function retryFire(button)
    if not caps.getconnections then return false, "no getconnections" end
    local fake = retryInput(button)
    local fired, seen = 0, 0
    for _, name in ipairs({ "Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up" }) do
        local ok, list = pcall(getconnections, button[name])
        if ok and type(list) == "table" then
            for _, connection in ipairs(list) do
                if connection.Enabled ~= false then
                    seen = seen + 1
                    local okFire = pcall(function() connection:Fire(fake) end)
                    if not okFire then okFire = pcall(function() connection:Fire() end) end
                    if okFire then fired = fired + 1 end
                end
            end
        end
    end
    return fired > 0, string.format("connections %d/%d", fired, seen)
end

-- AbsolutePosition includes the top inset when the ScreenGui does not ignore
-- it, while injected mouse coordinates start at the top of the window.
local function retryPoint(button)
    local point = GuiAuto.centre(button)
    if not point then return nil end
    local x, y = point.X, point.Y
    local ignore = false
    pcall(function()
        local gui = button:FindFirstAncestorWhichIsA("ScreenGui")
        ignore = gui ~= nil and gui.IgnoreGuiInset == true
    end)
    if not ignore then
        local inset = 0
        pcall(function()
            local value = game:GetService("GuiService"):GetGuiInset()
            if value then inset = value.Y or 0 end
        end)
        y = y - inset
    end
    return x, y
end

-- Real synthetic click: unlock the pointer first, click, restore what the farm
-- had so aiming keeps working afterwards.
local function retryClick(button)
    if not caps.vim then return false, "no vim" end
    local x, y = retryPoint(button)
    if not x then return false, "no position" end
    local uis = game:GetService("UserInputService")
    local okBehavior, behavior = pcall(function() return uis.MouseBehavior end)
    local okIcon, icon = pcall(function() return uis.MouseIconEnabled end)
    pcall(function() uis.MouseBehavior = Enum.MouseBehavior.Default end)
    pcall(function() uis.MouseIconEnabled = true end)
    local ok = pcall(function()
        caps.vim:SendMouseMoveEvent(x, y, 0, game)
        task.wait(0.05)
        caps.vim:SendMouseButtonEvent(x, y, 0, true, game, 0)
        task.wait(0.08)
        caps.vim:SendMouseButtonEvent(x, y, 0, false, game, 0)
    end)
    task.wait(0.2)
    pcall(function()
        if okIcon and icon ~= nil then uis.MouseIconEnabled = icon end
        if okBehavior and behavior then uis.MouseBehavior = behavior end
    end)
    return ok, string.format("vim %d,%d", x, y)
end

-- Gamepad-style activation: select the button, send Return, then clear it.
local function retryGamepad(button)
    local gui = game:GetService("GuiService")
    local okPrev, previous = pcall(function() return gui.SelectedObject end)
    if not pcall(function() gui.SelectedObject = button end) then
        return false, "select failed"
    end
    local sent = false
    if caps.vim then
        sent = pcall(function()
            caps.vim:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
            task.wait(0.06)
            caps.vim:SendKeyEvent(false, Enum.KeyCode.Return, false, game)
        end)
    end
    task.wait(0.15)
    pcall(function() gui.SelectedObject = (okPrev and previous) or nil end)
    if not sent then return false, "gamepad no vim" end
    return true, "gamepad return"
end

local function retryRewards()
    local playerGui = getPlayerGui()
    local interface = playerGui and playerGui:FindFirstChild("Interface")
    return interface and interface:FindFirstChild("Rewards")
end

local function retryGone(button)
    local rewards = retryRewards()
    if not rewards or not rewards.Parent then return true, "rewards gone" end
    local okVisible, visible = pcall(function() return rewards.Visible end)
    if okVisible and visible == false then return true, "rewards hidden" end
    if resultsSignature() == nil then return true, "results closed" end
    if not button or not button.Parent then return true, "retry button gone" end
    return false
end

-- One attempt: press, wait a second, then require the screen to actually change.
local function retryVerify(beforeLabel, button)
    task.wait(1)
    local gone, why = retryGone(button)
    local label = retryLabel(button)
    if gone then return true, tostring(why) .. " label " .. label end
    if label ~= beforeLabel and string.find(label, "1/1", 1, true) then
        return true, "vote label " .. label
    end
    return false, "label " .. label
end

local function retryTick(now)
    local startedAt = S.startedAt or BOOT.startedAt or now
    if now - startedAt < 1.5 then return end
    local signature = resultsSignature()
    if not signature then
        S.results = false
        if Retry.active then
            Retry.active = false
            Retry.note("closed", "results screen gone")
            S.autoMsg = "auto: retry verified, results closed"
        end
        return
    end
    if not S.results then
        S.results = true
        Exit.results(signature)
    end
    if not cfg.autoRetry then return end
    local gap = math.max(0.5, math.min(2, tonumber(cfg.retryCooldown) or 1))
    if Retry.last and now - Retry.last < gap then return end
    Retry.active = true

    local button = retryButton() or retryTargets()[1]
    if not button then
        Retry.last = clock()
        Retry.lastMethod, Retry.lastResult, Retry.lastLabel = "none", "retry button not found", "-"
        S.autoMsg = "auto: retry - button not found"
        return
    end
    local before = retryLabel(button)
    Retry.method = ((Retry.method or 0) % #RETRY_METHODS) + 1
    local method = RETRY_METHODS[Retry.method]
    Retry.tries = (Retry.tries or 0) + 1
    S.retries = Retry.tries
    local ok, detail
    if method == "connections" then
        ok, detail = retryFire(button)
    elseif method == "input" then
        ok, detail = retryClick(button)
    else
        ok, detail = retryGamepad(button)
    end
    local closed, why = retryVerify(before, button)
    Retry.last = clock()
    Retry.lastMethod = method
    Retry.lastResult = tostring(detail) .. " -> " .. tostring(why)
    Retry.lastLabel = retryLabel(retryButton() or button)
    Retry.note(method, Retry.lastResult .. " fired=" .. tostring(ok))
    S.state = "retry " .. tostring(method) .. " " .. tostring(detail)
    S.autoMsg = "auto: " .. tostring(method) .. " " .. tostring(detail) .. " -> " .. tostring(why)
    if closed then
        say("retry verified: " .. tostring(why))
    end
end
--============================================================================
local SwingNet = { open = false }

-- One variadic poster. post2/post3 silently dropped the fourth argument, so
-- Hitboxes/Register never sent its time difference. Every argument is sent.
local function post(...)
    if not Net.post then return false, "POST RemoteEvent not found" end
    local args = packArgs(...)
    local ok, err = pcall(Net.post.FireServer, Net.post, table.unpack(args, 1, args.n))
    return ok, err
end

-- The target nape always, plus the crowd around it when group hits are on.
-- The server caps how many registers one swing is worth, so the list is short.
local function napeList(nape, model)
    local list = { nape }
    if not cfg.multiHit or (S.cluster or 0) < cfg.multiMin then return list end
    local okPos, centre = pcall(function() return nape.Position end)
    if not okPos or not centre then return list end
    local folder = workspace:FindFirstChild("Titans")
    if not folder then return list end
    local cap = math.max(1, math.min(6, cfg.napeMult or 6))
    for _, other in ipairs(folder:GetChildren()) do
        if #list >= cap then break end
        if other:IsA("Model") and other ~= model and other ~= localChar() and not dead(other) then
            local otherNape = napeOf(other)
            if otherNape then
                local ok, position = pcall(function() return otherNape.Position end)
                if ok and position and (position - centre).Magnitude <= cfg.multiRadius then
                    list[#list + 1] = otherNape
                end
            end
        end
    end
    return list
end
--============================================================================
local SlashButton = nil

local function fireSignal(signal)
    local fired, counted = false, false
    if caps.getconnections then
        local ok, connections = pcall(getconnections, signal)
        if ok and type(connections) == "table" then
            counted = true
            for _, connection in ipairs(connections) do
                if pcall(function() connection:Fire() end) then fired = true end
            end
        end
    end
    -- With getconnections available, an empty list is a definitive "nothing is
    -- listening". Falling back to firesignal there reports success on a dead
    -- signal - which is exactly how the farm stopped swinging: the log shows
    -- the Slash button at down=0 up=0.
    if counted then return fired end
    if caps.firesignal then return (pcall(firesignal, signal)) end
    return false
end

local function slashButton()
    if SlashButton and SlashButton.Parent then return SlashButton end
    SlashButton = nil
    local gui = getPlayerGui()
    if not gui then return nil end
    local ok, all = pcall(function() return gui:GetDescendants() end)
    if not ok or type(all) ~= "table" then return nil end
    for _, instance in ipairs(all) do
        if instance.Name == "Slash" and instance:IsA("GuiButton") then
            SlashButton = instance
            return instance
        end
    end
    return nil
end

local function guiSwing()
    local button = slashButton()
    if not button then return false end
    if not fireSignal(button.MouseButton1Down) then return false end
    task.delay(0.03, function()
        pcall(function() fireSignal(button.MouseButton1Up) end)
    end)
    return true
end

-- Returns how many calls were sent; a hit is only confirmed by HitSignal.
local function remoteSwing(target)
    if not target then return 0 end
    local nape = target.nape
    if not nape or not nape.Parent then
        nape = napeOf(target.model)
        target.nape = nape
    end
    if not nape or not nape.Parent then return 0 end
    if cfg.remoteTemplate and Template.available() then
        local sent = Template.replay(target, nape)
        if sent > 0 then
                    return sent
        end
    end
    if not post("Attacks", "Slash", true) then return 0 end
    SwingNet.open = true
    -- The client releases a fraction of a second after the press; the server
    -- expects both halves, so mirror that gap instead of firing one call.
    task.delay(0.03, function()
        SwingNet.open = false
        post("Attacks", "Slash", false)
    end)
    local sent = 0
    for _, part in ipairs(napeList(nape, target.model)) do
        -- Time_Difference is the gap since the last release; post() forwards
        -- every argument now, so the 0.12 actually reaches the server.
        if post("Hitboxes", "Register", part, 0.12) then sent = sent + 1 end
    end
    return sent
end
--============================================================================
local function attackReady()
    if not S.running or S.refilling or S.reloading or S.results then return false end
    if S.bladesBroken then return false end
    if (Refill.settleUntil or 0) > clock() then return false end
    local target = S.target
    if not target or dead(target.model) then return false end
    -- Measured to the titan, not the nape: right before a slash the nape is
    -- still welded at the titan and attackTick is the thing that pulls it in.
    if not S.titanDist then return false end
    return S.titanDist <= (S.hoverNow or cfg.hover or 120) + 45
end

local function meterReset()
    local M = S.meter
    M.swings, M.damage, M.hits, M.kills, M.swingsSinceKill = 0, 0, 0, 0, 0
    M.lastDamage, M.lastSpeed, M.lastPull, M.lastPullRan = 0, 0, "off", false
    M.lastSwingBefore, M.lastSwingAfter, M.lastSwingAt = 0, 0, 0
    M.lastHealth, M.watchHumanoid, M.deadCounted = nil, nil, false
    M.recent, M.pending, M.current, M.watch = {}, {}, nil, nil
    M.registers, M.avgSpeed, M.zeroRegisterRun = 0, 0, 0
    M.armedRegistered, M.lastRegisterAt, M.armAt = false, nil, nil
end

local function meterTick()
    local M = S.meter
    if not M then return end
    local humanoid = M.watchHumanoid
    if humanoid and humanoid.Parent then
        local health = tonumber(humanoid.Health)
        if health ~= nil then
            if M.lastHealth == nil then
                M.lastHealth = health
            else
                if health <= 0 and (M.lastHealth or 0) > 0 and not M.deadCounted then
                    M.kills = (M.kills or 0) + 1
                    M.swingsSinceKill = 0
                    M.deadCounted = true
                end
                M.lastHealth = health
            end
        end
    end
    if M.watch then HitSignal.check(M.watch) end
    if not M.pending or #M.pending == 0 then return end
    local now = clock()
    local keep = {}
    for _, pending in ipairs(M.pending) do
        if pending.watch then HitSignal.check(pending.watch) end
        local entry = pending.entry
        if pending.watch and pending.watch.hit and not pending.applied then
            pending.applied = true
            local damage = tonumber(pending.watch.damage) or 0
            M.damage = (M.damage or 0) + damage
            M.hits = (M.hits or 0) + 1
            S.hits = (S.hits or 0) + 1
            M.lastDamage = damage
            local hp = pending.humanoid and pending.humanoid.Parent
                and tonumber(pending.humanoid.Health) or nil
            if hp then M.lastSwingAfter = hp end
            if entry then
                entry.after = hp or entry.after
                entry.damage = damage
                entry.confirmed = true
            end
            if M.current == entry then M.current.confirmed = true end
            if pending.path then Path.note(pending.path, true) end
            S.swingsNoHit, S.watchdogStage, S.watchdogMsg = 0, 0, nil
        end
        local done = pending.watch and (pending.watch.hit or pending.watch.done)
        local timedOut = now - (pending.at or now) > 0.45
        if done or timedOut then
            if not (pending.watch and pending.watch.hit) then
                if entry and pending.humanoid and pending.humanoid.Parent then
                    entry.after = tonumber(pending.humanoid.Health) or entry.after
                end
                if pending.path then Path.note(pending.path, false) end
                if Path.nohitEligible() then S.swingsNoHit = (S.swingsNoHit or 0) + 1 end
            end
        else
            keep[#keep + 1] = pending
        end
    end
    M.pending = keep
end

local function noteSwing(pullRan, healthBefore, path, watchBefore)
    local M = S.meter
    local target = S.target
    local humanoid = target and target.model and target.model:FindFirstChildOfClass("Humanoid")
    local before = watchBefore or HitSignal.fast(target and target.model)
    if healthBefore ~= nil then before.health = healthBefore end
    M.swings = (M.swings or 0) + 1
    M.swingsSinceKill = (M.swingsSinceKill or 0) + 1
    S.swings = (S.swings or 0) + 1
    M.lastSpeed = S.swingVel and S.swingVel.Magnitude or 0
    M.lastPull = S.pullMethod or "off"
    M.lastPullRan = pullRan == true
    M.lastSwingBefore = healthBefore or (humanoid and humanoid.Health) or 0
    M.lastSwingAfter = M.lastSwingBefore
    M.lastDamage = 0
    M.lastSwingAt = clock()
    M.watchHumanoid = humanoid
    M.lastHealth = M.lastSwingBefore
    M.deadCounted = M.lastSwingBefore <= 0
    local watch = {
        model = target and target.model, before = before, at = clock(),
        damage = 0, hit = false, done = false, path = path,
    }
    M.watch = watch
    local entry = {
        at = clock(), before = M.lastSwingBefore, after = M.lastSwingBefore,
        damage = 0, speed = M.lastSpeed, pull = M.lastPull, ran = M.lastPullRan,
        humanoid = humanoid, path = path, confirmed = false,
        registered = M.armedRegistered == true,
    }
    M.recent[#M.recent + 1] = entry
    while #M.recent > 30 do table.remove(M.recent, 1) end
    local sum, count = 0, 0
    for index = math.max(1, #M.recent - 9), #M.recent do
        sum = sum + (M.recent[index].speed or 0)
        count = count + 1
    end
    M.avgSpeed = count > 0 and sum / count or 0
    M.zeroRegisterRun = (M.zeroRegisterRun or 0) + 1
    if entry.registered then M.zeroRegisterRun = 0 end
    M.current = entry
    M.pending[#M.pending + 1] = {
        model = target and target.model, humanoid = humanoid, watch = watch,
        entry = entry, path = path, at = clock(),
    }
    return entry
end

local function executeSwing(countStats, pullRan)
    local now = clock()
    if S.slashReleaseAt and now < S.slashReleaseAt then return nil end
    if S.nextSlashAt and now < S.nextSlashAt then return nil end
    local target = S.target
    if not target or not target.model then return nil end
    if cfg.freshOverlap == true and Pin.active then
        if not Pin.cycle then
            Pin.startCycle()
            return nil
        end
        if Pin.cycle.stage ~= "hit" then return nil end
    end
    local humanoid = target.model:FindFirstChildOfClass("Humanoid")
    local healthBefore = humanoid and humanoid.Health or nil

    local autoDown = false
    if (tonumber(cfg.swingSpeed) or 0) <= 0
        and clock() - (S.startedAt or clock()) >= 3 then
        local average = tonumber(S.meter.avgSpeed) or 0
        if average < 300 then autoDown = true end
    end
    local _, swingRoot = myChar()
    if swingRoot then
        if (tonumber(cfg.swingSpeed) or 0) > 0 then
            local look = swingRoot.CFrame.LookVector
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.01 then flat = Vector3.new(0, 0, -1) end
            swingRoot.AssemblyLinearVelocity = flat.Unit * cfg.swingSpeed
            S.swingBoostUntil = clock() + 0.15
        elseif autoDown then
            local down = math.min(tonumber(cfg.speedCap) or 800, 700)
            swingRoot.AssemblyLinearVelocity = Vector3.new(0, -down, 0)
            S.swingBoostUntil = clock() + 0.15
        end
    end
    local _, velocityRoot = myChar()
    S.swingVel = velocityRoot and velocityRoot.AssemblyLinearVelocity or nil

    local interval = math.clamp(tonumber(cfg.swingInterval) or 0.20, 0.12, 0.40)
    S.slashReleaseAt = clock() + 0.03
    S.nextSlashAt = clock() + interval
    task.delay(0.03, function() S.slashReleaseAt = nil end)

    local swingPath = cfg.attackPath
    if swingPath ~= "gui" and swingPath ~= "remote" then swingPath = "mouse" end
    S.meter.armAt = clock()
    S.meter.armedRegistered = false
    -- The watch baseline must be taken before the click: a server can apply
    -- damage synchronously while the click is being sent.
    local preWatch = HitSignal.fast(target.model)
    local fired = false
    if swingPath == "gui" then
        fired = guiSwing()
        if fired then S.clickPath = "gui" end
    elseif swingPath == "remote" then
        fired = remoteSwing(target) > 0
        if fired then S.clickPath = "remote" end
    else
        fired = click(target)
    end
    if not fired then
        if Pin.active then Pin.park("click failed") end
        return nil
    end
    if Pin.afterClick then Pin.afterClick() end
    if cfg.tapSpace then keyTap(Enum.KeyCode.Space, 0.02) end
    -- Do not block the attack loop waiting 0.4 s for a hit. The meterTick task
    -- owns the pending watch, so the configured swing interval is the cadence.
    noteSwing(pullRan, healthBefore, swingPath, preWatch)
    return swingPath, false, 0
end

local function watchdogTick()
    if cfg.countRegisters ~= true or HitSignal.registerAvailable ~= true then return end
    local M = S.meter
    local window = 30
    if #M.recent < window then return end
    local registered = 0
    for index = #M.recent - window + 1, #M.recent do
        if M.recent[index] and M.recent[index].registered then
            registered = registered + 1
        end
    end
    local ratio = registered / window
    if ratio >= 0.2 then
        S.watchdogStage, S.watchdogMsg = 0, nil
        return
    end
    local now = clock()
    if now - (S.watchdogAt or 0) < 15 then return end
    S.watchdogAt = now
    S.watchdogStage = (S.watchdogStage or 0) + 1
    local stage = S.watchdogStage
    if stage == 1 then
        if Pin.active then Pin.park("watchdog: re-park") end
        if S.target then S.target.nape = napeOf(S.target.model) end
        S.watchdogMsg = "re-park (registers low)"
    elseif stage == 2 then
        S.slashReleaseAt, S.nextSlashAt = nil, nil
        S.watchdogMsg = "reset swing timing (registers low)"
    else
        local humanoid = S.target and S.target.model
            and S.target.model:FindFirstChildOfClass("Humanoid")
        local health = humanoid and humanoid.Health
        if health ~= nil then
            if S.wdHp ~= nil and health < S.wdHp - 0.5 then
                S.wdHpDropAt = now
            end
            S.wdHp = health
        end
        local losing = S.wdHpDropAt and now - S.wdHpDropAt < 3
        if (M.zeroRegisterRun or 0) < 60 or losing then
            S.watchdogStage = 2
            S.watchdogMsg = losing and "hold: target losing health"
                or "hold: need 60 zero-register swings"
            say("watchdog: " .. tostring(S.watchdogMsg))
            return
        end
        local newTarget = chooseTarget()
        if newTarget and (not S.target or newTarget.model ~= S.target.model) then
            S.target = newTarget
            S.target.nape = napeOf(newTarget.model)
            Pin.stop("watchdog: target switch")
            if cfg.pinNape then Pin.ensure(S.target) end
            M.zeroRegisterRun = 0
            S.watchdogMsg = "switch target to " .. tostring(S.target and S.target.name or "none")
        else
            S.watchdogMsg = "target switch: no other target"
        end
    end
    say("watchdog: " .. tostring(S.watchdogMsg))
end

local function attackTick()
    if not attackReady() then
        if Pin.active then Pin.park("pin: out of range") end
        return
    end
    local now = clock()
    if S.slashReleaseAt and now < S.slashReleaseAt then return end
    if S.nextSlashAt and now < S.nextSlashAt then return end
    if cfg.pinNape then
        if not Pin.ensure(S.target) then
            pcall(applyNapes)
            task.wait()
        end
    else
        if Pin.active then Pin.stop("pin off") end
        pcall(applyNapes)
        task.wait()
    end
    executeSwing(true, S.pullRan == true)
    watchdogTick()
end

local function fastTick(now)
    if not S.running then return end
    Refill.readBlades(localChar())
    if S.owner ~= "refill" then
        if S.reloading and Hover.base then
            S.owner = "farm"
            Hover.goal = Hover.base
        else
            S.owner = nil
            Hover.goal = nil
        end
    end
    if S.refillPauseUntil and now < S.refillPauseUntil then
        if Refill.holding then refillKeyUp() end
        releaseInput()
        S.state = "manual control"
        return
    end
    local _, root, humanoid = myChar()
    if not root then
        S.state = "no character"
        S.target = nil
        return
    end
    if humanoid and humanoid.Health <= 0 then
        releaseInput()
        if S.refilling then
            refillKeyUp()
            Refill.attempt = nil
            S.refilling = false
            setOwner(nil)
            S.refillMsg = "refill cancelled - dead"
        end
        S.state = "dead - waiting for respawn"
        S.target = nil
        return
    end
    local kindNow = currentKind()
    if kindNow ~= S.kindSeen then S.kindSeen, S.kindSince = kindNow, now end
    if kindNow == "mission" and now - (S.kindSince or now) < 4 then
        releaseInput()
        S.state = "mission entry - holding still"
        return
    end
    if S.results then
        if S.refilling then refillCancel("refill cancelled - results screen") end
        S.state = "results screen - waiting for retry"
        return
    end
    if kindNow ~= "mission" and not workspace:FindFirstChild("Titans") then
        if S.refilling then refillCancel("refill cancelled - lobby") end
        releaseInput()
        S.target = nil
        S.state = "lobby - waiting for a round"
        return
    end
    if kindNow == "mission" and (S.alive or 0) == 0 and not S.refilling then
        releaseInput()
        S.target = nil
        S.state = S.emptySince
            and ("mission - no titans for " .. math.floor(now - S.emptySince) .. "s")
            or "mission - waiting for titans"
        return
    end
    if S.reloading or S.refilling or now >= (S.nextRefillCheck or 0) then
        S.nextRefillCheck = now + ((S.reloading or S.refilling) and 0.1 or 0.25)
        if refillTick(now, root) then return end
    end

    local target = S.target
    if target and dead(target.model) then
        S.target = nil
        target = nil
    end
    if not target then
        S.target = chooseTarget()
        target = S.target
    end
    if not target then
        releaseInput()
        S.state = "no titans in range"
        return
    end

    local hrp = target.model:FindFirstChild("HumanoidRootPart")
    if not hrp then
        S.target = nil
        return
    end
    local nape = target.nape
    if not nape or not nape.Parent then
        target.nape = napeOf(target.model)
        nape = target.nape
    end
    if not nape then
        S.state = "target has no nape"
        return
    end

    local height = cfg.hover or 200
    local _, titanType = pcall(function() return target.model:GetAttribute("Type") end)
    if target.name == "Attack_Titan" or titanType == "Attack" or titanType == "Colossal" then
        height = height + 40
    elseif titanType == "Stall" then
        height = math.max(60, height - 20)
    end
    S.hoverNow = height

    local titanPos = hrp.Position
    hoverAt(root, titanPos, height)

    local okPos, napePosition = pcall(function() return nape.Position end)
    local okTitan, titanDistance = pcall(function() return (titanPos - root.Position).Magnitude end)
    S.titanDist = okTitan and titanDistance or nil
    S.dist = S.titanDist

    local aimPoint = titanPos
    if okPos and napePosition and (napePosition - root.Position).Magnitude >= 12 then
        aimPoint = napePosition
    end
    if cfg.multiHit and (S.cluster or 0) >= cfg.multiMin then
        local centre = clusterCentre(target.model)
        if centre then aimPoint = centre end
    end

    S.aimTick = (S.aimTick or 0) + 1
    if S.aimTick % 2 == 1 then
        aimAt(root, currentCamera(), aimPoint)
    end
    S.state = "attacking " .. tostring(target.name)
end

local function slowTick(now)
    if not cfg.napeEnabled then S.napeParts = 0 end
    pruneNapes()

    local stat = nil
    pcall(function() stat = tonumber(lp:GetAttribute("Stat")) end)
    if stat ~= nil and S.statSeen ~= nil and stat > S.statSeen then
        S.kills = S.kills + (stat - S.statSeen)
    end
    S.statSeen = stat

    S.gas = gasPercent()
    refillCounts()

    local folder = workspace:FindFirstChild("Titans")
    local alive = 0
    if folder then
        for _, model in ipairs(folder:GetChildren()) do
            if model:IsA("Model") and not dead(model) then alive = alive + 1 end
        end
    end
    S.alive = alive
    if alive == 0 then
        if not S.emptySince then S.emptySince = now end
    else
        S.emptySince = nil
    end

    local okType, roundType = pcall(function() return workspace:GetAttribute("Type") end)
    S.roundType = okType and roundType or nil

    if not S.rateAt then S.rateAt, S.rateSwings = now, S.swings end
    if now - S.rateAt >= 1 then
        S.rate = (S.swings - S.rateSwings) / (now - S.rateAt)
        S.rateAt, S.rateSwings = now, S.swings
    end

    retryTick(now)
    refreshStatus()
end

local function startFarm()
    if S.running then return true end
    cfg.autoFarm = true
    S.running = true
    S.runId = (S.runId or 0) + 1
    local runId = S.runId
    S.err = nil
    S.results = false
    S.refilling, S.reloading = false, false
    Retry.tries, Retry.last, Retry.method, Retry.active = 0, nil, 0, false
    S.retries = 0
    Retry.lastMethod, Retry.lastResult, Retry.lastLabel = nil, nil, nil
    Refill.tries, Refill.nextPress, Refill.until_ = 0, 0, 0
    Refill.reloadStarted, Refill.reloadNextPress, Refill.reloadTries = 0, 0, 0
    Refill.settleUntil, Refill.lastSets, Refill.lastDurability = 0, nil, nil
    Refill.attempt = nil
    Refill.cycles = 0
    Refill.attempts, Refill.failures = 0, 0
    Refill.holding, Refill.holdUntil, Refill.nextTry = false, 0, 0
    Refill.stationScan, Refill.maxSets = 0, 3
    Refill.lastMethod, Refill.lastHold = "-", 0
    Refill.decision, Refill.why = "idle", "not checked"
    S.statSeen = nil
    S.pulls, S.napeParts, S.pullSlash, S.titanDist, S.hoverNow = 0, 0, 0, nil, nil
    S.drift, S.lastDrift, S.jointsOff, S.jointsOn = 0, 0, 0, 0
    S.pullMethod, S.pullMsg, S.pullRan = "off", nil, false
    S.nextSlashAt, S.slashReleaseAt = nil, nil
    S.pullStrikes, S.pullBlockedUntil = 0, nil
    Pin.stop(nil)
    Path.reset()
    S.pinActive, S.pinMsg, S.pinDrift = false, nil, 0
    S.swingsNoHit, S.watchdogStage, S.watchdogMsg = 0, 0, nil
    S.registers, S.watchdogAt, S.wdHp, S.wdHpDropAt = 0, nil, nil, nil
    S.swings, S.hits, S.kills = 0, 0, 0
    meterReset()
    S.owner, S.swingBoostUntil, S.swingVel = nil, nil, nil
    S.refillReason, S.refillMsg, S.refillPauseUntil = nil, nil, nil
    S.durability, S.durabilityX, S.durabilityY, S.durabilitySource = nil, nil, nil, nil
    S.refills, S.refillsAttr, S.refillsText = nil, nil, nil
    S.bladesBroken = false
    S.emptySince = nil
    S.resultsAt, S.resultsAtText = nil, nil
    S.gameExitAt, S.gameExitText = nil, nil
    S.nextRefillCheck = nil
    S.startedAt = clock()
    S.kindSeen = currentKind()
    S.kindSince = -1000
    pcall(function() S.statSeen = tonumber(lp:GetAttribute("Stat")) end)
    pcall(function()
        S.target = chooseTarget()
    end)
    pcall(fastTick, clock())

    safeSpawn(function()
        while S.running and S.runId == runId do
            local ok, err = pcall(fastTick, clock())
            if not ok then setError("fastTick", err) end
            task.wait(cfg.tick)
        end
    end)
    safeSpawn(function()
        while S.running and S.runId == runId do
            local ok, err = pcall(attackTick)
            if not ok then setError("attackTick", err) end
            task.wait(1 / math.max(1, cfg.attackHz))
        end
    end)
    safeSpawn(function()
        while S.running and S.runId == runId do
            local ok, err = pcall(meterTick)
            if not ok then setError("meterTick", err) end
            task.wait(0.05)
        end
    end)
    safeSpawn(function()
        while S.running and S.runId == runId do
            local ok, err = pcall(slowTick, clock())
            if not ok then setError("slowTick", err) end
            task.wait(0.25)
        end
    end)
    say("started")
    refreshControls()
    return true
end

local function stopFarm()
    if not S.running then return false end
    S.running = false
    cfg.autoFarm = false
    S.runId = (S.runId or 0) + 1
    S.target = nil
    refillKeyUp()
    S.refilling, S.reloading = false, false
    Refill.attempt = nil
    Refill.settleUntil = 0
    S.dist = nil
    S.state = "stopped"
    S.pullMethod, S.pullMsg, S.pullRan = "off", "farm stopped", false
    if SwingNet.open then
        SwingNet.open = false
        post("Attacks", "Slash", false)
    end
    Pin.stop("farm stopped")
    restoreNapes()
    hoverStop()
    S.swingBoostUntil = nil
    S.owner = nil
    releaseInput()
    say("stopped")
    refreshControls()
    return true
end

-- Auto reload/refill/retry are standalone helpers. They keep running while the
-- farm itself is stopped, including after the user toggles Auto farm off.
safeSpawn(function()
    while true do
        task.wait(0.1)
        if not S.running then
            local now = clock()
            local okRetry, retryErr = pcall(retryTick, now)
            if not okRetry then setError("auto retry", retryErr) end
            local _, root, humanoid = myChar()
            local active = S.refilling or S.reloading
            local healthy = humanoid and humanoid.Health > 0
            if root and (active or (healthy and not S.results)) then
                local okRefill, refillErr = pcall(refillTick, now, root)
                if not okRefill then setError("auto reload/refill", refillErr) end
            end
        end
    end
end, "standby maintenance")

