-- autoFarm is saved only when the player changes it (panel toggle or P). Plain
-- saves keep the remembered value, so the re-execute stop cannot wipe an ON.
local autoFarmSaved = false

local function saveCfg(markAutoFarm)
    if not caps.writefile then return false end
    if markAutoFarm then autoFarmSaved = cfg.autoFarm == true end
    local out = {}
    for _, key in ipairs(PERSIST) do out[key] = cfg[key] end
    out.autoFarm = autoFarmSaved
    local ok, encoded = pcall(function() return HttpService:JSONEncode(out) end)
    if not ok then return false end
    return (pcall(writefile, CFG_FILE, encoded))
end

local function loadCfg()
    if not (caps.isfile and caps.readfile) then return end
    local okFile = pcall(isfile, CFG_FILE)
    if not okFile or not isfile(CFG_FILE) then return end
    local ok, source = pcall(readfile, CFG_FILE)
    if not ok or type(source) ~= "string" then return end
    local okDecode, saved = pcall(function() return HttpService:JSONDecode(source) end)
    if not okDecode or type(saved) ~= "table" then return end
    for _, key in ipairs(PERSIST) do
        if saved[key] ~= nil then cfg[key] = saved[key] end
    end
    -- Old saved configs used fallLimit=45, which clamped every descent to
    -- 45 studs/s. Reset that one legacy value once; leave deliberate new saves.
    if saved.cfgVersion == nil then
        if tonumber(saved.fallLimit) == 45 then cfg.fallLimit = 0 end
        if saved.tapSpace == false then cfg.tapSpace = true end
        cfg.cfgVersion = 1
    end
    autoFarmSaved = cfg.autoFarm == true
end

loadCfg()

