local function activeIsLive(active)
    if type(active) ~= "table" or active.alive == false then return false end
    if active.build ~= BUILD or active.job ~= SERVER_KEY then return false end
    local now = os.clock()
    local beat = type(active.heartbeat) == "number"
        and now >= active.heartbeat and (now - active.heartbeat) < 10
    local registered = type(genv.AOTR) == "table"
        and genv.AOTR._token == active.token and genv.AOTR._job == SERVER_KEY
    return beat or registered
end

