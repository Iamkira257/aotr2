safeSpawn(function()
    if cfg.autoFarm ~= true then
        BOOT.stage = "auto farm OFF"
        BOOT.failed = nil
        return
    end
    BOOT.stage = "Interface"
    local deadline = clock() + 30
    local ready = false
    while clock() < deadline do
        local playerGui = getPlayerGui()
        local char = localChar()
        local humanoid = nil
        if char then
            pcall(function() humanoid = char:FindFirstChildOfClass("Humanoid") end)
        end
        local loaded = false
        pcall(function() loaded = game:IsLoaded() end)
        if loaded and humanoid and playerGui
            and playerGui:FindFirstChild("Interface") then
            ready = true
            BOOT.ready = true
            BOOT.failed = nil
            break
        end
        task.wait(0.5)
    end
    if not ready then
        BOOT.stage = "failed"
        BOOT.failed = "game/Interface timeout"
        writeLog("autostart: failed - game/Interface timeout")
        return
    end
    if cfg.autoFarm ~= true or S.running then
        if S.running then
            BOOT.stage = "started"
            BOOT.started = true
            BOOT.elapsed = clock() - BOOT.startedAt
        else
            BOOT.stage = "auto farm OFF"
            BOOT.failed = nil
        end
        return
    end
    BOOT.stage = "starting"
    local ok, err = pcall(startFarm)
    if not ok then
        BOOT.stage = "failed"
        BOOT.failed = "startFarm: " .. tostring(err)
        setError("autostart", err)
        return
    end
    if S.running ~= true then
        BOOT.stage = "failed"
        BOOT.failed = "startFarm did not start"
        writeLog("autostart: failed - startFarm did not start")
        return
    end
    S.kindSince = clock()
    S.autoMsg = "auto started from saved setting"
    BOOT.stage = "started"
    BOOT.started = true
    BOOT.elapsed = clock() - BOOT.startedAt
    writeLog(string.format("autostart: started in %.1fs", BOOT.elapsed))
end, "auto start")

