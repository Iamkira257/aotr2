local Refill = {
    tries = 0, nextPress = 0, until_ = 0, cycles = 0, attempt = nil,
    reloadStarted = 0, reloadNextPress = 0, reloadTries = 0,
    reloadSets = nil, reloadDurability = nil,
    settleUntil = 0, lastSets = nil, lastDurability = nil,
    decision = "idle", why = "not checked",
    attempts = 0, failures = 0, maxSets = 3, lastMethod = "-", lastHold = 0,
    holding = false, holdUntil = 0, nextTry = 0, stationScan = 0,
}

-- Count the actual blade parts. A set is only spent when all 14 parts have
-- become transparent; this prevents an early reload at the 2% UI sliver.
function Refill.bladeCounts(char)
    local total, clear = 0, 0
    local rig = char and char:FindFirstChild("Rig_" .. lp.Name)
    local left = rig and rig:FindFirstChild("LeftHand")
    local right = rig and rig:FindFirstChild("RightHand")
    for _, hand in ipairs({ left, right }) do
        if hand then
            for index = 1, 7 do
                local blade = hand:FindFirstChild("Blade_" .. index)
                if blade then
                    total = total + 1
                    local ok, transparency = pcall(function() return blade.Transparency end)
                    if ok and type(transparency) == "number" and transparency >= 0.95 then
                        clear = clear + 1
                    end
                end
            end
        end
    end
    return total, clear
end

-- The HUD durability is the gradient on Blades.Inner.Bar. Empty is about 0,
-- full is about 1.0; the old exact Transparency == 1 check missed settled blades.
function Refill.readBlades(char)
    if not char then return nil end
    local blades = hudNode(hudTop(), "Blades")
    local gradient = nil
    if blades then
        local inner = blades:FindFirstChild("Inner")
        local bar = inner and inner:FindFirstChild("Bar")
        gradient = bar and bar:FindFirstChild("Gradient")
        if not gradient then
            local found = blades:FindFirstChild("Gradient", true)
            if found and found:IsA("UIGradient") then gradient = found end
        end
    end
    if gradient then
        local okX, x = pcall(function() return gradient.Offset.X end)
        local okY, y = pcall(function() return gradient.Offset.Y end)
        if okX and type(x) == "number" and x == x then
            S.durabilityX, S.durabilityY = x, okY and y or nil
            S.durabilitySource = "gradient"
            S.durability = x
            local total, clear = Refill.bladeCounts(char)
            if total == 14 then
                S.bladesBroken = clear == 14
            else
                S.bladesBroken = x <= 0.005
            end
            return x
        end
    end

    local total, clear = Refill.bladeCounts(char)
    S.durabilityX, S.durabilityY = nil, nil
    if total == 0 then
        S.durabilitySource = "none"
        S.durability = nil
        S.bladesBroken = false
        return nil
    end
    S.durabilitySource = "blades"
    S.bladesBroken = total == 14 and clear == 14
    -- Transparency 1 means a spent blade, so invert the clear count.
    S.durability = (total - clear) / total
    return S.durability
end

local function manualMove()
    local ok, down = pcall(function()
        return UserInput:IsKeyDown(Enum.KeyCode.W)
            or UserInput:IsKeyDown(Enum.KeyCode.A)
            or UserInput:IsKeyDown(Enum.KeyCode.S)
            or UserInput:IsKeyDown(Enum.KeyCode.D)
    end)
    return ok and down or false
end

local function refillCounts()
    local hudText = hudSetsText()
    local sets = tonumber(string.match(tostring(hudText), "(%d+)"))
    local attr = nil
    pcall(function() attr = tonumber(lp:GetAttribute("Refills")) end)
    S.refills, S.refillsAttr, S.refillsText = sets, attr, hudText
    return sets, attr, hudText
end

local function refillReason(sets, broken)
    if not broken then
        if sets == 0 then return nil, "idle", "sets 0; blades not fully broken" end
        if S.durability == nil then return nil, "idle", "blades unreadable" end
        if S.durability >= 0.99 then return nil, "idle", "blades full" end
        return nil, "idle", "blades partly worn"
    end
    if sets == nil then return nil, "idle", "fully broken; HUD sets unreadable" end
    if sets >= 1 then
        if cfg.autoReload == false then return nil, "idle", "fully broken; auto reload off" end
        return "reload", "reload", "fully broken; " .. tostring(sets) .. " spare set(s)"
    end
    if cfg.refill ~= true then return nil, "idle", "last blade; auto refill off" end
    return "refill", "refill", "last blade; sets 0"
end

local function findPrompt(part)
    if not part then return nil end
    for _, descendant in ipairs(part:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") and descendant.Enabled ~= false then return descendant end
    end
    local parent = part.Parent
    if parent then
        for _, descendant in ipairs(parent:GetDescendants()) do
            if descendant:IsA("ProximityPrompt") and descendant.Enabled ~= false then
                return descendant
            end
        end
    end
    return nil
end

-- R is a hold, not a tap. Keep it down between ticks so the station sees a
-- continuous hold, and release it the moment the blades are full.
local function refillKeyDown()
    if Refill.holding then return true end
    if not keyDown(Enum.KeyCode.R) then return false end
    Refill.holding = true
    return true
end

local function refillKeyUp()
    if not Refill.holding then return end
    Refill.holding = false
    keyUp(Enum.KeyCode.R)
end

-- HUD text is "3 / 3": the part after the slash is the maximum.
local function refillMaxSets(text)
    local _, maximum = string.match(tostring(text or ""), "(%d+)%s*/%s*(%d+)")
    local value = tonumber(maximum)
    if value and value > 0 then return value end
    return 3
end

local function refillTeleport(root, part)
    if not root or not part then return false end
    return pcall(function()
        root.CFrame = CFrame.new(part.Position + Vector3.new(0, 3, 0))
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end)
end

-- One attempt: teleport to the station, then hold R or fire the prompt.
-- Successive attempts alternate methods; a bare station just keeps using R.
local function refillAttempt(now, root, sets, durability, gas)
    local part = refillPart()
    if not part then
        -- 0 is truthy in Lua, so the first scan must be initialised explicitly.
        if not Refill.stationScan or Refill.stationScan == 0 then
            Refill.stationScan = now
        end
        if now - Refill.stationScan < 10 then
            S.state = "refill: looking for a gas station"
            S.refillMsg = S.state
            return true
        end
        refillKeyUp()
        Refill.attempt, Refill.failures, Refill.stationScan = nil, 0, 0
        S.refilling = false
        Refill.until_ = now + 30
        setOwner(nil)
        S.state = "refill: no gas station on this map"
        S.refillMsg, S.autoMsg = S.state, S.state
        say(S.state)
        return true
    end
    Refill.stationScan = 0

    Refill.attempts = (Refill.attempts or 0) + 1
    local prompt = findPrompt(part)
    local method = "key"
    if Refill.attempts % 2 == 0 and prompt and caps.prompt then method = "prompt" end
    local hold = math.max(0.5, math.min(10, tonumber(cfg.refillHold) or 3))
    Refill.attempt = {
        started = now, progressAt = now, method = method, part = part, hold = hold,
        sets = sets, durability = durability, gas = gas,
    }
    Refill.lastMethod, Refill.lastHold = method, hold
    Refill.holdUntil = now + hold
    S.refilling, S.reloading = true, false
    setOwner("refill")
    local _, rootNow = myChar()
    refillTeleport(rootNow or root, part)
    if method == "prompt" then
        pcall(function() prompt.HoldDuration = 0 end)
        pcall(fireproximityprompt, prompt)
    else
        refillKeyDown()
    end
    S.refillMsg = string.format("attempt %d %s hold %.1fs", Refill.attempts, method, hold)
    S.state = S.refillMsg
    return true
end

local function refillCancel(reason)
    refillKeyUp()
    Refill.attempt = nil
    Refill.nextTry, Refill.stationScan = 0, 0
    S.refilling = false
    Refill.settleUntil = 0
    setOwner(nil)
    S.state, S.refillMsg = reason, reason
    Refill.decision, Refill.why = "idle", reason
    return false
end

local function refillTick(now, root)
    local durability = Refill.readBlades(localChar())
    local sets, attr, hudText = refillCounts()
    local gas = gasPercent()
    if gas ~= nil then S.gas = gas end
    gas = gas or S.gas
    local broken = S.bladesBroken == true

    -- Manual movement wins over both actions. Drop the attempt and give the
    -- player a few seconds before the farm takes the character back.
    if (S.refilling or S.reloading) and manualMove() then
        if S.refilling then
            -- Keep the refill alive, but hand the character back for 3 s.
            refillKeyUp()
            Refill.attempt = nil
            Refill.nextTry = now + 0.5
            Refill.settleUntil = 0
            S.refillPauseUntil = now + 3
            setOwner(nil)
            S.state = "refill paused - manual move (3s)"
            S.refillMsg = S.state
            Refill.decision, Refill.why = "locked", "manual move"
            say(S.refillMsg)
            return true
        end
        Refill.attempt = nil
        S.refilling, S.reloading = false, false
        Refill.until_ = now + math.max(3, cfg.refillCooldown or 12)
        Refill.settleUntil = 0
        S.refillPauseUntil = now + 3
        setOwner(nil)
        S.state = "reload cancelled - manual move"
        S.refillMsg = S.state
        Refill.decision, Refill.why = "locked", S.state
        say(S.refillMsg)
        return true
    end

    if S.refilling and cfg.refill ~= true then
        return refillCancel("auto refill OFF - station attempt cancelled")
    end
    if S.reloading and cfg.autoReload == false then
        S.reloading = false
        S.state = "auto reload OFF - reload cancelled"
        S.refillMsg = S.state
        return false
    end

    -- The bar tweens after a set/durability change. Do not trust it until it
    -- has been stable for about one second.
    local changed = false
    if Refill.lastSets ~= nil and sets ~= Refill.lastSets then changed = true end
    if Refill.lastDurability ~= nil and durability ~= Refill.lastDurability then changed = true end
    if changed and (S.reloading or S.refilling) then
        -- A reload can resume as soon as the new blade set is readable. Do not
        -- hold it behind the refill bar's one-second tween.
        local settle = S.reloading and 0.05 or 1
        Refill.settleUntil = math.max(Refill.settleUntil or 0, now + settle)
        Refill.reloadNextPress = math.max(Refill.reloadNextPress or 0, Refill.settleUntil)
        Refill.nextPress = math.max(Refill.nextPress or 0, Refill.settleUntil)
    end
    Refill.lastSets, Refill.lastDurability = sets, durability

    Refill.decision, Refill.why = "idle", "blades full"
    S.refillReason = nil

    if S.refilling then
        Refill.maxSets = refillMaxSets(hudText)
        if cfg.refill ~= true then return refillCancel("refill cancelled - auto refill OFF") end
        if S.results then return refillCancel("refill cancelled - results screen") end
        if currentKind() ~= "mission" then return refillCancel("refill cancelled - not in mission") end
        local _, _, humanoid = myChar()
        if not humanoid or humanoid.Health <= 0 then
            return refillCancel("refill cancelled - dead")
        end

        local setsFull = sets ~= nil and sets >= Refill.maxSets
        local bladesFull = durability ~= nil and durability >= 0.99
        if setsFull and bladesFull then
            refillKeyUp()
            Refill.attempt = nil
            Refill.failures, Refill.attempts = 0, 0
            Refill.cycles, Refill.tries = 0, 0
            S.refilling = false
            Refill.until_ = now + 2
            -- The station hold is released above; resume attacking now.
            Refill.settleUntil = now + 0.05
            setOwner(nil)
            S.state = string.format("refilled (sets %d/%d, durability %.2f)",
                sets, Refill.maxSets, durability)
            S.refillMsg = S.state
            S.autoMsg = S.state
            say("refill success: " .. S.state)
            return false
        end

        local attempt = Refill.attempt
        if not attempt then
            if now < (Refill.nextTry or 0) then return true end
            return refillAttempt(now, root, sets, durability, gas)
        end

        Refill.decision = "refill"
        Refill.why = string.format("attempt %d %s; need sets %d + durability 0.99",
            Refill.attempts, attempt.method, Refill.maxSets)
        S.refillReason = "decision refill - " .. Refill.why
        S.state = string.format("refilling (sets %s/%d, durability %s, gas %s%%)",
            tostring(sets), Refill.maxSets,
            durability and string.format("%.2f", durability) or "-",
            gas ~= nil and tostring(gas) or "?")

        -- "No progress" means no change in sets, durability or gas. Any change
        -- restarts the clock, so a slow refill is not cut off at 3 s.
        if sets ~= attempt.sets or durability ~= attempt.durability or gas ~= attempt.gas then
            attempt.sets, attempt.durability, attempt.gas = sets, durability, gas
            attempt.progressAt = now
        end

        if attempt.method == "key" and Refill.holding and now >= (Refill.holdUntil or 0) then
            refillKeyUp()
        end

        if now - (attempt.progressAt or attempt.started) >= 3 then
            refillKeyUp()
            Refill.attempt = nil
            Refill.failures = (Refill.failures or 0) + 1
            Refill.nextTry = now + 0.5
            if Refill.failures % 5 == 0 then
                refillObject = nil
                S.refillMsg = string.format("attempt %d %s failed - rescanning station",
                    Refill.attempts, attempt.method)
            else
                S.refillMsg = string.format("attempt %d %s failed (sets %s/%d, dur %s) - retrying",
                    Refill.attempts, attempt.method, tostring(sets), Refill.maxSets,
                    durability and string.format("%.2f", durability) or "-")
            end
            S.state = S.refillMsg
            say(S.refillMsg)
        end
        return true
    end

    if S.reloading then
        Refill.decision = "reload"
        Refill.why = "holding R; need durability >= 0.99"
        S.refillReason = "decision reload - " .. Refill.why
        S.state = string.format("reloading (sets %s, durability %s)",
            tostring(sets), durability and string.format("%.2f", durability) or "-")

        if now < (Refill.settleUntil or 0) then return false end
        local dropped = sets ~= nil and Refill.reloadSets ~= nil and sets < Refill.reloadSets
        if (durability ~= nil and durability >= 0.99) or (durability == nil and dropped) then
            S.reloading = false
            -- No one-second settle after a successful reload: the attack loop
            -- can resume on its next tick.
            Refill.settleUntil = now + 0.05
            Refill.cycles, Refill.tries = 0, 0
            Refill.reloadStarted, Refill.reloadNextPress, Refill.reloadTries = 0, 0, 0
            S.state = string.format("reloaded (sets %s, dropped=%s, durability %s)",
                tostring(sets), tostring(dropped),
                durability and string.format("%.2f", durability) or "-")
            S.refillMsg = S.state
            S.autoMsg = S.state
            say(S.state)
            return false
        end
        if now - (Refill.reloadStarted or now) >= 4 then
            S.reloading = false
            Refill.settleUntil = now + 1
            Refill.until_ = now + 1
            Refill.reloadStarted, Refill.reloadNextPress, Refill.reloadTries = 0, 0, 0
            S.state = string.format("reload timeout (sets %s, dropped=%s, durability %s)",
                tostring(sets), tostring(dropped),
                durability and string.format("%.2f", durability) or "-")
            S.refillMsg = S.state
            S.autoMsg = S.state
            say(S.state)
            return false
        end
        if now >= (Refill.reloadNextPress or 0) then
            keyTap(Enum.KeyCode.R, 0.5)
            Refill.reloadTries = (Refill.reloadTries or 0) + 1
            Refill.reloadNextPress = now + 1.0
        end
        return false
    end

    if now < (Refill.until_ or 0) and broken and sets == 0 then
        Refill.decision, Refill.why = "locked", "refill cooldown"
        S.refillReason = "decision locked - " .. Refill.why
        S.refilling, S.reloading = false, false
        return false
    end

    if now < (Refill.settleUntil or 0) then
        Refill.decision, Refill.why = "locked", "settle wait"
        S.refillReason = "decision locked - " .. Refill.why
        return false
    end

    if manualMove() then
        Refill.decision, Refill.why = "locked", "manual move"
        S.refillReason = "decision locked - " .. Refill.why
        return false
    end

    local reason, decision, why = refillReason(sets, broken)
    Refill.decision, Refill.why = decision or "idle", why or "blades full"
    S.refillReason = string.format("decision %s - %s", Refill.decision, Refill.why)
    if not reason then
        if Refill.attempt then
            Refill.attempt = nil
            S.refilling = false
            setOwner(nil)
        end
        Refill.cycles = 0
        return false
    end

    if reason == "reload" then
        Refill.reloadStarted = now
        Refill.reloadNextPress = now
        Refill.reloadTries = 0
        Refill.reloadSets, Refill.reloadDurability = sets, durability
        Refill.settleUntil = 0
        S.reloading, S.refilling = true, false
        -- Keep the existing hover base owned by the farm while R is held. The
        -- Heartbeat hover writer keeps running through the whole reload.
        if root then
            Hover.base = root.Position
            Hover.goal = root.Position
            Hover.face = nil
            S.owner = "farm"
            hoverLoop()
        end
        S.state = string.format("reloading (sets %s, durability %s)",
            tostring(sets), durability and string.format("%.2f", durability) or "-")
        S.refillMsg = S.state
        say(S.state)
        keyTap(Enum.KeyCode.R, 0.5)
        Refill.reloadTries = 1
        Refill.reloadNextPress = now + 1.0
        return false
    end

    -- reason == "refill": enter the station loop. It stays in control until
    -- the blades are full, a stop condition fires, or the station is not there.
    Refill.attempts, Refill.failures = 0, 0
    Refill.nextTry, Refill.stationScan = 0, 0
    Refill.lastMethod, Refill.lastHold = "-", 0
    Refill.maxSets = refillMaxSets(hudText)
    S.refilling, S.reloading = true, false
    setOwner("refill")
    say("refill: " .. tostring(S.refillReason))
    return refillAttempt(now, root, sets, durability, gas)
end

