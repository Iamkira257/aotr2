local function writeLog(line)
    pcall(function()
        local text = string.format("[%s] %s\n",
            os.date("%Y-%m-%d %H:%M:%S"), tostring(line))
        if type(appendfile) == "function" then
            local okAppend = pcall(appendfile, LOG_FILE, text)
            if okAppend then return end
        end
        if type(writefile) ~= "function" then return end
        local old = ""
        if type(readfile) == "function" then
            pcall(function() old = readfile(LOG_FILE) or "" end)
        end
        if #old > 32768 then old = old:sub(-32768) end
        writefile(LOG_FILE, old .. text)
    end)
end

local function setError(label, err)
    local message = tostring(label or "error") .. ": " .. tostring(err)
    BOOT.lastError = message
    if S then S.err = message end
    writeLog("ERROR " .. message)
end

local function safe(fn, label)
    return function(...)
        local ok, err = pcall(fn, ...)
        if not ok then setError(label or "callback", err) end
        return ok
    end
end

local function safeSpawn(fn, label)
    return task.spawn(safe(fn, label or "task"))
end

function BOOT.describe()
    local elapsed = math.max(0, os.clock() - (BOOT.startedAt or os.clock()))
    if BOOT.started then
        return string.format("started in %.1fs", BOOT.elapsed or elapsed)
    end
    if BOOT.failed then
        return string.format("failed - %s (%.1fs)", tostring(BOOT.failed), elapsed)
    end
    if BOOT.stage == "auto farm OFF" then return "idle - auto farm OFF" end
    if BOOT.stage == "starting" then
        return string.format("starting farm (%.1fs)", elapsed)
    end
    if BOOT.stage == "Interface" or BOOT.ready == true then
        return string.format("waiting for Interface (%.1fs)", elapsed)
    end
    return string.format("waiting for %s (%.1fs)", tostring(BOOT.stage or "game"), elapsed)
end

local function clearActive()
