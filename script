    end)
end

-- Return the queue function and the name shown on the panel.
local function queueFn()
    local candidates = {
        { "queue_on_teleport", function() return queue_on_teleport end },
        { "syn.queue_on_teleport", function() return syn and syn.queue_on_teleport end },
        { "fluxus.queue_on_teleport", function() return fluxus and fluxus.queue_on_teleport end },
        { "queueonteleport", function() return queueonteleport end },
    }
    for _, entry in ipairs(candidates) do
        local ok, fn = pcall(entry[2])
        if ok and type(fn) == "function" then return fn, entry[1] end
    end
    return nil, nil
end

local function sourceHint()
    return "paste " .. RUN_FILE .. " once"
end

-- The runner and the queued chunk both start with their own marker. Do not
-- mistake either wrapper for the main chunk when capturing text.
local function isMainSource(value)
    if type(value) ~= "string" or #value < 1000 then return false end
    local head = value:sub(1, 200)
    if head:find("AOTR_RUN_WRAPPER", 1, true) then return false end
    if head:find("AOTR_QUEUE_WRAPPER", 1, true) then return false end
    return value:find("AOTR internal", 1, true) ~= nil
        and value:find("local function buildQueueText", 1, true) ~= nil
end

local function isCurrentBuild(value)
    return type(value) == "string"
        and value:find('local BUILD = "' .. BUILD .. '"', 1, true) ~= nil
end

function AutoExec.checkSource(force)
    if AutoExec.sourceText and not force then return true end
    if AutoExec.captured and not force then return AutoExec.sourceOk == true end
    AutoExec.captured = true
    AutoExec.sourceText, AutoExec.sourceMethod, AutoExec.sourceBytes = nil, nil, nil
    AutoExec.sourceOk = false
    AutoExec.compileOk, AutoExec.compileErr, AutoExec.queueBytes = nil, nil, nil

    local env = nil
    pcall(function() env = getgenv() end)
    local carried = type(env) == "table" and env.AOTR_SOURCE or nil
    -- Prefer the chunk that is running now and the current BUILD. A previous
    -- loader can leave an older AOTR_SOURCE in memory; using it silently queues
    -- the old build. Keep an old main source as a last-resort fallback so an
    -- executor without debug source does not lose autoexecute entirely.
    local info = nil
    pcall(function() info = debug.getinfo(1, "S") end)
    local dbg = info and info.source or nil
    local clip = nil
    if caps.getclipboard then
        local ok, value = pcall(getclipboard)
        if ok then clip = value end
    end
    local candidates = {
        { value = dbg, method = "debug.getinfo" },
        { value = carried, method = tostring(env and env.AOTR_SOURCE_METHOD or "aotr_run.lua") },
        { value = clip, method = "clipboard" },
    }
    local chosen = nil
    for _, entry in ipairs(candidates) do
        if isMainSource(entry.value) and isCurrentBuild(entry.value) then
            chosen = entry
            break
        end
    end
    if not chosen then
        for _, entry in ipairs(candidates) do
            if isMainSource(entry.value) then
                chosen = entry
                break
            end
        end
    end
    if chosen then
        AutoExec.sourceText = chosen.value
        AutoExec.sourceMethod = chosen.method
    end

    if AutoExec.sourceText then
        AutoExec.sourceOk = true
        AutoExec.sourceBytes = #AutoExec.sourceText
        autoLog(string.format("source found via %s (%d B)",
            tostring(AutoExec.sourceMethod), AutoExec.sourceBytes))
    else
        autoLog("source not found - " .. sourceHint())
    end
    return AutoExec.sourceOk
end

-- Chunked save used by the runner fallback and the loader path. Every write is
-- pcall'ed, and the file is read back so a partial write cannot leave a broken copy.
function AutoExec.writeSource(source)
    if not caps.writefile then return false, "no writefile in this executor" end
    local chunk = 16000
    local size = #source
    if size <= chunk or not caps.appendfile then
        local ok, err = pcall(writefile, SOURCE_FILE, source)
        if not ok then return false, "writefile: " .. tostring(err) end
    else
        local ok, err = pcall(writefile, SOURCE_FILE, source:sub(1, chunk))
        if not ok then return false, "writefile: " .. tostring(err) end
        local at = chunk + 1
        while at <= size do
            local okPart, errPart = pcall(appendfile, SOURCE_FILE, source:sub(at, at + chunk - 1))
            if not okPart then
                return false, string.format("appendfile at byte %d: %s", at, tostring(errPart))
            end
            at = at + chunk
        end
    end
    if caps.isfile then
        local okExists, exists = pcall(isfile, SOURCE_FILE)
        if not okExists or not exists then return false, "file missing after write" end
    end
    if not caps.readfile then return true end
    local okRead, back = pcall(readfile, SOURCE_FILE)
    if not okRead or type(back) ~= "string" then return false, "read back failed" end
    if #back ~= size then
        return false, string.format("size mismatch: wrote %d, read %d", size, #back)
    end
    return true
end

function AutoExec.ensureSaved()
    if type(AutoExec.sourceText) ~= "string" or AutoExec.sourceText == "" then
        return false, "no source"
    end
    if not caps.writefile then return false, "no writefile in this executor" end
    if caps.isfile and caps.readfile then
        local okExists, exists = pcall(isfile, SOURCE_FILE)
        if okExists and exists then
            local okRead, back = pcall(readfile, SOURCE_FILE)
            if okRead and type(back) == "string" and #back == #AutoExec.sourceText then
                return true
            end
        end
    end
    local ok, why = AutoExec.writeSource(AutoExec.sourceText)
    if ok then
        autoLog(string.format("saved exact source to %s (%d B)", SOURCE_FILE, #AutoExec.sourceText))
    else
        autoLog("save source failed: " .. tostring(why))
    end
    return ok, why
end

-- Build the exact chunk passed to queue_on_teleport. Autoexecute always runs
-- the remote script through the URL below instead of a saved local copy.
local function buildQueueText()
    local text = table.concat({
        "-- AOTR_QUEUE_WRAPPER",
        "local AOTR_QUEUE_LOG = " .. string.format("%q", LOG_FILE),
        "local ok, err = pcall(function()",
        "    getgenv().AOTR_QUEUED_RUN = true",
        "    return loadstring(game:HttpGet(" .. string.format("%q", REMOTE_SCRIPT_URL) .. "))()",
        "end)",
        "if not ok then",
        "    pcall(function()",
        "        local line = string.format('[%s] queued run error: %s\\n', os.date('%Y-%m-%d %H:%M:%S'), tostring(err))",
        "        if type(appendfile) == 'function' then appendfile(AOTR_QUEUE_LOG, line)",
        "        elseif type(writefile) == 'function' then writefile(AOTR_QUEUE_LOG, line) end",
        "    end)",
        "end",
    }, "\n")
    return text
end

function AutoExec.compile(force)
    if AutoExec.compileOk ~= nil and not force then
        return AutoExec.compileOk, AutoExec.compileErr
    end
    AutoExec.compileOk, AutoExec.compileErr, AutoExec.queueBytes = nil, nil, nil
    if type(loadstring) ~= "function" then
        AutoExec.compileOk = false
        AutoExec.compileErr = "no compiler in this executor"
        return false, AutoExec.compileErr
    end
    local queueText, why = buildQueueText()
    if not queueText then
        AutoExec.compileOk = false
        AutoExec.compileErr = tostring(why)
        return false, AutoExec.compileErr
    end
    local okQueue, fnQueue, errQueue = pcall(loadstring, queueText)
    if not okQueue then
        AutoExec.compileOk = false
        AutoExec.compileErr = tostring(fnQueue)
        return false, AutoExec.compileErr
    end
    if not fnQueue then
        AutoExec.compileOk = false
        AutoExec.compileErr = tostring(errQueue)
        return false, AutoExec.compileErr
    end
    AutoExec.queueBytes = #queueText
    AutoExec.compileOk = true
    AutoExec.compileErr = nil
    return true
end

function AutoExec.test()
    local fn, name = queueFn()
    AutoExec.queueName = name
    local savedFlag = readSavedFlag("autoExecute")
    AutoExec.savedOn = savedFlag == true
    AutoExec.savedAt = os.clock()
    local compiled, compileWhy = AutoExec.compile(true)

    local plan
    if not name then
        plan = "no queue_on_teleport in this executor"
    elseif not compiled then
        plan = "compile failed"
    elseif savedFlag ~= true then
        plan = "would not run: saved autoExecute OFF"
    elseif AutoExec.queuedFor == jobKey() then
        plan = "already queued for this server"
    else
        plan = "would queue; new server runs, same server exits duplicate"
    end

    AutoExec.testText = string.format("test: remote %s | %s | saved %s | queue %s | %s",
        REMOTE_SCRIPT_URL,
        compiled and "compiles OK" or ("compile error: " .. tostring(compileWhy)),
        savedFlag == nil and "?" or (savedFlag and "ON" or "OFF"),
        tostring(name or "none"),
        plan)
    autoLog(AutoExec.testText)
    return AutoExec.testText
end

function AutoExec.refresh()
    AutoExec.checkedAt = os.clock()
    local fn, name = queueFn()
    AutoExec.queueName = name
    local savedFlag = readSavedFlag("autoExecute")
    if savedFlag == nil then AutoExec.savedOn = nil else AutoExec.savedOn = savedFlag == true end
    AutoExec.savedAt = os.clock()

    if cfg.autoExecute ~= true then
        AutoExec.reason = nil
        return false
    end
    if not fn then
        AutoExec.reason = "no queue_on_teleport in this executor"
        autoLog("queue failed: " .. AutoExec.reason)
        return false
    end
    local compiled, compileWhy = AutoExec.compile()
    if not compiled then
        AutoExec.reason = "queue text does not compile: " .. tostring(compileWhy)
        autoLog("queue failed: " .. AutoExec.reason)
        return false
    end
    local key = jobKey()
    if AutoExec.queuedFor == key then return true end

    local queueText, why = buildQueueText()
    if not queueText then
        AutoExec.reason = tostring(why)
        autoLog("queue failed: " .. AutoExec.reason)
        return false
    end
    local ok, err = pcall(fn, queueText)
    if not ok then
        AutoExec.reason = "queue failed: " .. tostring(err)
        autoLog("queue failed: " .. AutoExec.reason)
        return false
    end
    AutoExec.queuedFor = key
    AutoExec.queueCount = AutoExec.queueCount + 1
    AutoExec.lastAt = os.date("%H:%M:%S")
    AutoExec.reason = nil
    autoLog(string.format("queued x%d for job=%s via %s, remote %s, queue %d B",
        AutoExec.queueCount, key, tostring(name), REMOTE_SCRIPT_URL,
        AutoExec.queueBytes or 0))
    return true
end

function AutoExec.describe()
    local now = os.clock()
    if not AutoExec.savedAt or now - AutoExec.savedAt > 2 then
        local savedFlag = readSavedFlag("autoExecute")
        if savedFlag == nil then AutoExec.savedOn = nil else AutoExec.savedOn = savedFlag == true end
        AutoExec.savedAt = now
    end
    local parts = {
        "auto: " .. (cfg.autoExecute == true and "ON" or "OFF"),
        "saved " .. (AutoExec.savedOn == nil and "?" or (AutoExec.savedOn and "ON" or "OFF")),
        "queue " .. tostring(AutoExec.queueName or "none"),
        "remote",
    }
    if AutoExec.compileOk == true then
        parts[#parts + 1] = "compiles OK"
    elseif AutoExec.compileOk == false then
        parts[#parts + 1] = "compile error"
    end
    if AutoExec.queueCount > 0 then
        parts[#parts + 1] = string.format("queued x%d @ %s",
            AutoExec.queueCount, tostring(AutoExec.lastAt or "?"))
    end
    if AutoExec.testText then parts[#parts + 1] = AutoExec.testText end
    if AutoExec.reason then parts[#parts + 1] = AutoExec.reason end
    return table.concat(parts, " | ")
end

