local Template = { data = nil, loaded = false, loadedAt = 0 }

function Template.load()
    if Template.loaded and Template.data then return Template.data end
    if Template.loaded and clock() - (Template.loadedAt or 0) < 2 then return nil end
    local function missing()
        Template.loaded, Template.loadedAt = true, clock()
        return nil
    end
    if not (caps.isfile and caps.readfile) then return missing() end
    local okFile, exists = pcall(isfile, "aotr_swing_template.json")
    if not okFile or not exists then return missing() end
    local ok, source = pcall(readfile, "aotr_swing_template.json")
    if not ok or type(source) ~= "string" then return missing() end
    local okDecode, data = pcall(function() return HttpService:JSONDecode(source) end)
    if not okDecode or type(data) ~= "table" or type(data.calls) ~= "table" then return missing() end
    Template.data, Template.loadedAt = data, clock()
    Template.loaded = true
    return data
end

function Template.build(item, target, nape)
    if type(item) ~= "table" then return nil end
    if item.kind == "nil" then return nil end
    if item.kind == "number" or item.kind == "string" or item.kind == "boolean" then return item.value end
    if item.kind == "Instance" then
        local flat = string.lower(tostring(item.path or item.name or ""))
        if string.find(flat, "nape", 1, true) or string.find(flat, "hitboxes", 1, true) then
            return nape
        end
        local model = target and target.model
        local found = model and model:FindFirstChild(tostring(item.name), true)
        if not found then
            local char = localChar()
            if char then found = char:FindFirstChild(tostring(item.name), true) end
        end
        if not found then found = workspace:FindFirstChild(tostring(item.name), true) end
        return found or nape
    end
    if item.kind == "CFrame" then return nape and nape.CFrame or nil end
    if item.kind == "Vector3" then
        return nape and nape.Position or Vector3.new(item.x or 0, item.y or 0, item.z or 0)
    end
    if item.kind == "table" then
        local out = {}
        for index, child in ipairs(item.values or {}) do out[index] = Template.build(child, target, nape) end
        return out
    end
    return nil
end

function Template.available()
    return Template.load() ~= nil
end

function Template.replay(target, nape)
    local data = Template.load()
    if not data then return 0 end
    local calls = {}
    for _, entry in ipairs(data.calls or {}) do
        local endpoint = entry.args and entry.args[1] and entry.args[1].value
        if (entry.remote == "POST" or entry.remote == "GET" or entry.remote == "GET_2")
            and (endpoint == "Attacks" or endpoint == "Hitboxes") then
            calls[#calls + 1] = entry
        end
    end
    local sent, previous = 0, nil
    for _, entry in ipairs(calls) do
        local gap = math.max(0, (entry.at or 0) - (previous and previous.at or 0))
        previous = entry
        local function send()
            local args = {}
            for index, item in ipairs(entry.args or {}) do args[index] = Template.build(item, target, nape) end
            local remote = (entry.remote == "GET" and Net.get)
                or (entry.remote == "GET_2" and Net.get2) or Net.post
            if remote then
                if entry.method == "InvokeServer" and remote:IsA("RemoteFunction") then
                    pcall(remote.InvokeServer, remote, table.unpack(args))
                else
                    pcall(remote.FireServer, remote, table.unpack(args))
                end
            end
        end
        if sent == 0 or gap <= 0.001 then send() else task.delay(gap, send) end
        sent = sent + 1
    end
    return sent
end
