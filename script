    local playerGui = getPlayerGui()
    if not playerGui then return nil, "-" end
    local ok, list = pcall(function() return playerGui:GetGuiObjectsAtPosition(x, y) end)
    if not ok or type(list) ~= "table" then return nil, "-" end
    local names, button = {}, nil
    for _, object in ipairs(list) do
        if #names < 3 then names[#names + 1] = tostring(object.Name) end
        if not button then
            local okButton, isButton = pcall(function() return object:IsA("GuiButton") end)
            if okButton and isButton and not isOurs(object) then button = object end
        end
    end
    return button, table.concat(names, ">")
end

function GuiAuto.matches(instance, aliases)
    return (buttonMatches(instance, aliases))
end

-- True when the hit test at the button centre actually reaches the button (or a
-- child of it). A hidden duplicate passes every Visible check and still no
-- click ever lands on it.
function GuiAuto.hits(button)
    local point = GuiAuto.centre(button)
    local playerGui = getPlayerGui()
    if not point or not playerGui then return false, "" end
    local ok, list = pcall(function() return playerGui:GetGuiObjectsAtPosition(point.X, point.Y) end)
    if not ok or type(list) ~= "table" then return false, "" end
    local names = {}
    for index = 1, math.min(#list, 6) do
        names[#names + 1] = tostring(list[index].Name)
    end
    for _, object in ipairs(list) do
        local node = object
        for _ = 1, 12 do
            if node == button then return true, table.concat(names, ">") end
            node = node.Parent
            if not node then break end
        end
    end
    return false, table.concat(names, ">")
end

--============================================================================
local function clusterAt(model)
    local probe = napeOf(model)
    if not probe then return 0 end
    local okPos, centre = pcall(function() return probe.Position end)
    if not okPos or not centre then return 0 end
    local folder = workspace:FindFirstChild("Titans")
    if not folder then return 0 end
    local count = 0
    for _, other in ipairs(folder:GetChildren()) do
        if other:IsA("Model") and other ~= model and not dead(other) then
            local nape = napeOf(other)
            if nape then
                local ok, position = pcall(function() return nape.Position end)
                if ok and position and (position - centre).Magnitude <= cfg.multiRadius then
                    count = count + 1
                end
            end
        end
    end
    return count
end

local function clusterCentre(model)
    local probe = napeOf(model)
    if not probe then return nil end
    local okPos, centre = pcall(function() return probe.Position end)
    if not okPos or not centre then return nil end
    local folder = workspace:FindFirstChild("Titans")
    if not folder then return centre end
    local sum, count = Vector3.new(0, 0, 0), 0
    for _, other in ipairs(folder:GetChildren()) do
        if other:IsA("Model") and other ~= model and not dead(other) then
            local nape = napeOf(other)
            if nape then
                local ok, position = pcall(function() return nape.Position end)
                if ok and position and (position - centre).Magnitude <= cfg.multiRadius then
                    sum = sum + position
                    count = count + 1
                end
            end
        end
    end
    if count == 0 then return centre end
    return Vector3.new(sum.X / (count + 1), sum.Y / (count + 1), sum.Z / (count + 1))
end

local function attackTitan()
    local folder = workspace:FindFirstChild("Titans")
    local titan = folder and folder:FindFirstChild("Attack_Titan")
    if titan and titan.Parent and not dead(titan) then return titan end
    return nil
end

local function roaring(titan)
    if not titan then return false end
    local ok, value = pcall(function() return titan:GetAttribute("Attack") end)
    return ok and value == "Roar"
end

-- nearest | attack (Attack Titan first) | hp (lowest health first), with a
-- a crowd bonus when group hits are on.
local function chooseTarget()
    local folder = workspace:FindFirstChild("Titans")
    local _, root = myChar()
    if not folder or not root then return nil end
    local origin = root.Position
    local boss = attackTitan()

    if boss and not roaring(boss) and cfg.priority ~= "hp" then
        local nape = napeOf(boss)
        local hrp = boss:FindFirstChild("HumanoidRootPart")
        if nape and hrp then
            return { model = boss, nape = nape, name = boss.Name, dist = (hrp.Position - origin).Magnitude }
        end
    end

    local best, bestScore = nil, nil
    for _, model in ipairs(folder:GetChildren()) do
        if model:IsA("Model") and model ~= localChar() and not dead(model) and not (model == boss and roaring(model)) then
            local nape = napeOf(model)
            local hrp = model:FindFirstChild("HumanoidRootPart")
            if nape and hrp then
                local distance = (hrp.Position - origin).Magnitude
                local score = distance
                if cfg.priority == "hp" then score = hpOf(model) * 10000 + distance end
                if cfg.multiHit then
                    local crowd = clusterAt(model)
                    if crowd >= cfg.multiMin then score = score - crowd * 1000 end
                end
                if bestScore == nil or score < bestScore then
                    bestScore = score
                    best = { model = model, nape = nape, name = model.Name, dist = distance }
                end
            end
        end
    end
    return best
end
--============================================================================
local HitSignal = {}

local function attrSnapshot(inst, prefix, out)
    if not inst then return end
    local ok, attributes = pcall(function() return inst:GetAttributes() end)
    if ok and type(attributes) == "table" then
        for key, value in pairs(attributes) do
            if type(value) == "number" then out[prefix .. key] = value end
        end
    end
end

local function valueSnapshot(inst, prefix, out, deep)
    if not inst then return end
    local okChildren, children = pcall(function()
        return deep and inst:GetDescendants() or inst:GetChildren()
    end)
    if not okChildren or type(children) ~= "table" then return end
    for _, child in ipairs(children) do
        if child:IsA("ValueBase") then
            local ok, value = pcall(function() return child.Value end)
            if ok and type(value) == "number" then out[prefix .. child.Name] = value end
        end
    end
end

function HitSignal.fast(model)
    local out = {}
    if not model then return out end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if humanoid then out.health = humanoid.Health end
    attrSnapshot(model, "attr:", out)
    local nape = napeOf(model)
    if nape then
        attrSnapshot(nape, "nattr:", out)
        attrSnapshot(nape.Parent, "hattr:", out)
        valueSnapshot(nape, "value:", out, false)
        valueSnapshot(nape.Parent, "value:", out, false)
    end
    local flat = string.lower(tostring(cfg.hitSignal or "auto"))
    if flat ~= "auto" and out[cfg.hitSignal] == nil then
        local value = HitSignal.readKey(model, cfg.hitSignal)
        if value ~= nil then out[cfg.hitSignal] = value end
    end
    return out
end

function HitSignal.readKey(model, key)
    if not model or type(key) ~= "string" then return nil end
    if key == "health" then
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        return humanoid and humanoid.Health or nil
    end
    if key == "maxhealth" then
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        return humanoid and humanoid.MaxHealth or nil
    end
    if key == "player:Stat" then return tonumber(lp:GetAttribute("Stat")) end
    local kind, name = string.match(key, "^(%a+):(.+)$")
    if not kind then return nil end
    local nape = napeOf(model)
    if kind == "attr" then
        local ok, value = pcall(function() return model:GetAttribute(name) end)
        return ok and tonumber(value) or nil
    end
    if kind == "nattr" then
        local ok, value = pcall(function() return nape and nape:GetAttribute(name) end)
        return ok and tonumber(value) or nil
    end
    if kind == "hattr" then
        local ok, value = pcall(function() return nape and nape.Parent and nape.Parent:GetAttribute(name) end)
        return ok and tonumber(value) or nil
    end
    if kind == "dattr" then
        local partName, attrName = string.match(name, "^([^:]+):(.+)$")
        if not partName then return nil end
        local okFind, part = pcall(function() return model:FindFirstChild(partName, true) end)
        if not okFind or not part then return nil end
        local ok, value = pcall(function() return part:GetAttribute(attrName) end)
        return ok and tonumber(value) or nil
    end
    if kind == "value" then
        for _, holder in ipairs({ nape, nape and nape.Parent, model }) do
            if holder then
                local okFind, inst = pcall(function() return holder:FindFirstChild(name, true) end)
                if okFind and inst and inst:IsA("ValueBase") then
                    local ok, value = pcall(function() return inst.Value end)
                    if ok and type(value) == "number" then return value end
                end
            end
        end
    end
    return nil
end

function HitSignal.diff(before, after)
    local changes = {}
    for key, old in pairs(before or {}) do
        local new = after and after[key]
        if new ~= nil and new ~= old then
            changes[#changes + 1] = { key = key, before = old, after = new, delta = new - old }
        end
    end
    table.sort(changes, function(a, b) return math.abs(a.delta) > math.abs(b.delta) end)
    return changes
end

function HitSignal.check(watch)
    if not watch or watch.done or not watch.model then return false end
    if clock() - (watch.at or 0) > 0.7 then
        watch.done = true
        return watch.hit == true
    end
    local after = HitSignal.fast(watch.model)
    local changes = HitSignal.diff(watch.before, after)
    if #changes == 0 then return false end
    -- Health regen and 0.01 attribute jitter are not hits. Health only counts
    -- when it drops; other numeric signals must move by at least 0.5.
    local usable = {}
    for _, change in ipairs(changes) do
        if change.key ~= "player:Stat" and change.key ~= "maxhealth" then
            if change.key == "health" then
                if change.delta <= -0.5 then usable[#usable + 1] = change end
            elseif math.abs(change.delta) >= 0.5 then
                usable[#usable + 1] = change
            end
        end
    end
    if #usable == 0 then return false end
    local chosen = nil
    if cfg.hitSignal and cfg.hitSignal ~= "auto" and after[cfg.hitSignal] ~= nil then
        for _, change in ipairs(usable) do
            if change.key == cfg.hitSignal then chosen = change break end
        end
    end
    chosen = chosen or usable[1]
    local damage = math.abs(chosen.delta)
    if chosen.key == "health" then damage = math.max(0, -chosen.delta) end
    watch.hit = true
    watch.damage = (watch.damage or 0) + damage
    watch.signal = chosen.key
    watch.before = after
    watch.done = true
    return true
end
-- Honest hit registration: the client still owns the rendered blade, but the
-- server emits POST:FireServer("Hitboxes", "Register", ...) when the blade
-- actually overlaps the nape. Count those calls as swing/register telemetry.
function HitSignal.installRegisterHook()
    HitSignal.registerAvailable = false
    HitSignal.registerReason = nil
    if type(hookmetamethod) ~= "function" or type(getnamecallmethod) ~= "function" then
        HitSignal.registerReason = "hookmetamethod/getnamecallmethod unavailable"
        return false
    end
    local assets = Replicated and Replicated:FindFirstChild("Assets")
    local remotes = assets and assets:FindFirstChild("Remotes")
    local postRemote = remotes and remotes:FindFirstChild("POST")
    if not postRemote or not postRemote:IsA("RemoteEvent") then
        HitSignal.registerReason = "ReplicatedStorage.Assets.Remotes.POST missing"
        return false
    end
    local oldNamecall = nil
    pcall(function()
        local mt = getrawmetatable and getrawmetatable(game)
        if mt then oldNamecall = rawget(mt, "__namecall") end
    end)
    local function hook(self, ...)
        if HitSignal.hookActive ~= true and type(oldNamecall) == "function" then
            return oldNamecall(self, ...)
        end
        local caller = false
        if type(checkcaller) == "function" then pcall(function() caller = checkcaller() end) end
        if caller then
            if type(oldNamecall) == "function" then return oldNamecall(self, ...) end
            return
        end
        if self == postRemote and cfg.countRegisters ~= false then
            local method = getnamecallmethod()
            if method == "FireServer" then
                local a, b = ...
                if a == "Hitboxes" and b == "Register" then
                    local now = clock()
                    local M = S.meter
                    HitSignal.lastRegisterAt = now
                    S.registers = (S.registers or 0) + 1
                    M.registers = (M.registers or 0) + 1
                    M.zeroRegisterRun = 0
                    if M.armAt and now - M.armAt <= 0.4 then
                        M.armedRegistered = true
                    end
                    for index = #M.recent, 1, -1 do
                        local entry = M.recent[index]
                        if entry and not entry.registered and now - (entry.at or 0) <= 0.4 then
                            entry.registered = true
                            break
                        end
                    end
                end
            end
        end
        if type(oldNamecall) == "function" then return oldNamecall(self, ...) end
    end
    local wrapped = hook
    if type(newcclosure) == "function" then wrapped = newcclosure(hook) end
    local ok, old = pcall(hookmetamethod, game, "__namecall", wrapped)
    if not ok then
        HitSignal.registerReason = "hookmetamethod failed: " .. tostring(old)
        return false
    end
    if type(old) == "function" then oldNamecall = old end
    if type(oldNamecall) ~= "function" then
        HitSignal.registerReason = "original __namecall unavailable"
        return false
    end
    HitSignal.originalNamecall = oldNamecall
    HitSignal.hookActive = true
    HitSignal.registerAvailable = true
    HitSignal.hookRemote = postRemote
    return true
end

HitSignal.installRegisterHook()

-- Heartbeat, and the nape is only released on death / switch / pause / stop.
local Pin = {
    active = false, part = nil, model = nil, joints = {}, size = nil, canCollide = nil,
    offset = nil, at = 0, base = nil, drift = 0, msg = nil, conn = nil,
    cycle = nil, mode = nil,
}

local function pinJoints(model, part)
    local list = {}
    local ok, joints = pcall(function() return part:GetJoints() end)
    if ok and type(joints) == "table" then
        for _, joint in ipairs(joints) do list[#list + 1] = joint end
    end
    if #list == 0 and model then
        for _, descendant in ipairs(model:GetDescendants()) do
            if descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint") then
                local okParts, part0, part1 = pcall(function() return descendant.Part0, descendant.Part1 end)
                if okParts and (part0 == part or part1 == part) then list[#list + 1] = descendant end
            end
        end
    end
    return list
end

function Pin.natural()
    if not Pin.part then return nil end
    for _, item in ipairs(Pin.joints) do
        if item.other and item.other.Parent and item.offset then
            local ok, cf = pcall(function() return item.other.CFrame * item.offset end)
            if ok and cf then return cf end
        end
    end
    return nil
end

function Pin.writePark()
    local natural = Pin.natural()
    if natural and Pin.part and Pin.part.Parent then
        pcall(function() Pin.part.CFrame = natural end)
    end
    Pin.mode = "park"
end

function Pin.writeHit()
    local _, root = myChar()
    if root and Pin.part and Pin.part.Parent then
        pcall(function() Pin.part.CFrame = root.CFrame * Pin.offset end)
    end
    Pin.mode = "hit"
end

function Pin.stop(reason)
    if not Pin.active then return false end
    local natural = Pin.natural()
    if natural and Pin.part and Pin.part.Parent then
        pcall(function() Pin.part.CFrame = natural end)
    end
    for _, item in ipairs(Pin.joints) do
        if item.parent and item.joint.Parent == nil then
            pcall(function() item.joint.Parent = item.parent end)
        end
        pcall(function() item.joint.Enabled = item.enabled end)
        if item.enabled then S.jointsOn = (S.jointsOn or 0) + 1 end
    end
    if Pin.part and Pin.part.Parent then
        if Pin.size then pcall(function() Pin.part.Size = Pin.size end) end
        if Pin.canCollide ~= nil then pcall(function() Pin.part.CanCollide = Pin.canCollide end) end
    end
    S.jointsOff = math.max(0, (S.jointsOff or 0) - #Pin.joints)
    Pin.active, Pin.part, Pin.model, Pin.joints = false, nil, nil, {}
    Pin.size, Pin.canCollide, Pin.offset, Pin.base, Pin.drift = nil, nil, nil, nil, 0
    Pin.cycle, Pin.mode = nil, nil
    S.pinActive, S.pullRan, S.pullMethod = false, false, "off"
    if reason then S.pinMsg = reason end
    return true
end

function Pin.park(reason)
    if not Pin.active then return false end
    Pin.writePark()
    Pin.cycle = { stage = "park", beats = 0 }
    if reason then S.pinMsg = reason end
    return true
end

function Pin.startCycle()
    if not Pin.active then return false end
    if cfg.freshOverlap ~= true then Pin.writeHit(); return true end
    if not Pin.cycle then
        Pin.cycle = { stage = "park", beats = 0 }
        Pin.writePark()
    end
    return true
end

function Pin.afterClick()
    if cfg.freshOverlap ~= true or not Pin.active or not Pin.cycle then return end
    Pin.cycle.stage = "hold"
    Pin.cycle.holdUntil = clock() + (tonumber(cfg.holdOnPlayer) or 0.14)
end

function Pin.ensure(target)
    if not cfg.pinNape or not cfg.napeEnabled then
        if Pin.active then Pin.stop("pin off") end
        return false
    end
    if not target or not target.model then Pin.stop("pin: no target") return false end
    local nape = target.nape
    if not nape or not nape.Parent then
        nape = napeOf(target.model)
        target.nape = nape
    end
    if not nape or not nape.Parent then Pin.stop("pin: nape missing") return false end
    if Pin.active and Pin.model == target.model and Pin.part == nape and Pin.part.Parent then
        return true
    end
    Pin.stop(nil)
    Pin.part, Pin.model, Pin.size = nape, target.model, nape.Size
    local okCollide, canCollide = pcall(function() return nape.CanCollide end)
    Pin.canCollide = okCollide and canCollide or nil
    Pin.offset = CFrame.new(0, cfg.magnetY or 2, 0)
    local disabled = 0
    for _, joint in ipairs(pinJoints(target.model, nape)) do
        local okParts, part0, part1 = pcall(function() return joint.Part0, joint.Part1 end)
        local other = okParts and ((part0 == nape) and part1 or part0) or nil
        if other and other ~= nape then
            local enabled = true
            pcall(function() enabled = joint.Enabled end)
            local parent = joint.Parent
            local okOffset, offset = pcall(function() return other.CFrame:ToObjectSpace(nape.CFrame) end)
            local detached = pcall(function() joint.Enabled = false end)
            if cfg.pullDetach == "unparent" and (joint:IsA("Weld") or joint:IsA("WeldConstraint")) then
                local okParent = pcall(function() joint.Parent = nil end)
                if okParent then detached = true end
            end
            if detached then disabled = disabled + 1 end
            Pin.joints[#Pin.joints + 1] = {
                joint = joint, enabled = enabled, parent = parent,
                other = other, offset = okOffset and offset or nil,
            }
        end
    end
    if disabled == 0 then
        Pin.stop("pin: no joint on the nape")
        S.pullMethod, S.pullRan = "touched", false
        S.pullMsg = "pin found no joint; per-swing Touched fallback will run"
        return false
    end
    pcall(function() nape.CanTouch = true end)
    local cube = cfg.magnetSize or 15
    if Pin.size ~= Vector3.new(cube, cube, cube) then
        pcall(function() nape.Size = Vector3.new(cube, cube, cube) end)
    end
    local hrp = target.model:FindFirstChild("HumanoidRootPart")
    Pin.base = hrp and hrp.Position or nil
    Pin.active, Pin.at, Pin.drift = true, clock(), 0
    Pin.cycle, Pin.mode = nil, "park"
    Pin.writePark()
    Pin.msg = string.format("pinned (%d joints off)", disabled)
    S.pinActive, S.pullRan, S.pullMethod, S.pullMsg = true, true, "pin", Pin.msg
    S.jointsOff = (S.jointsOff or 0) + disabled
    return true
end

function Pin.step()
    if not Pin.active then return end
    if not S.running or S.results or S.refilling then
        Pin.stop("pin paused")
        return
    end
    if not Pin.model or dead(Pin.model) or not Pin.part or not Pin.part.Parent then
        Pin.stop("pin released: target gone")
        return
    end
    local current = napeOf(Pin.model)
    if current and current ~= Pin.part then
        Pin.stop("pin: nape changed")
        return
    end
    local _, root = myChar()
    if not root then Pin.park("pin: no character") return end
    local hrp = Pin.model:FindFirstChild("HumanoidRootPart")
    local before = hrp and hrp.Position
    if cfg.freshOverlap == true then
        local cycle = Pin.cycle
        if not cycle then
            Pin.park(nil)
            cycle = Pin.cycle
        end
        if cycle.stage == "hold" and clock() < (cycle.holdUntil or 0) then
            Pin.writeHit()
        else
            if cycle.stage == "hold" then
                cycle.stage, cycle.beats = "park", 0
            end
            if cycle.stage == "hit" then
                Pin.writeHit()
            else
                Pin.writePark()
                cycle.beats = (cycle.beats or 0) + 1
                if cycle.beats >= 2 then
                    cycle.stage, cycle.beats = "hit", 0
                    Pin.writeHit()
                end
            end
        end
    else
        Pin.writeHit()
    end
    local after = hrp and hrp.Position
    if before and after then
        Pin.drift = (after - before).Magnitude
        S.lastDrift, S.drift = Pin.drift, math.max(S.drift or 0, Pin.drift)
        S.pinDrift = Pin.drift
        if Pin.drift > (cfg.pinDrift or 3) then
            local moved = Pin.drift
            cfg.pullDetach = "unparent"
            saveCfg()
            Pin.park(string.format("drift %.1f studs - re-parked", moved))
            S.autoMsg = string.format("pin drift %.1f studs: re-parked", moved)
        end
    end
    if Pin.active then S.pullRan, S.pullMethod = true, "pin" end
end

if RunService then
    Pin.conn = RunService.Heartbeat:Connect(safe(function() pcall(Pin.step) end, "connect"))
end
-- locked; every 50 swings the ladder is re-tested.
local Path = {
    order = { "gui", "remote", "mouse" }, index = 1, locked = nil, testAt = 0,
    counters = {}, msg = nil,
}

function Path.reset()
    Path.index, Path.locked, Path.testAt, Path.msg = 1, nil, 0, nil
    Path.counters = {
        gui = { swings = 0, hits = 0 },
        remote = { swings = 0, hits = 0 },
        mouse = { swings = 0, hits = 0 },
    }
end

function Path.current()
    local mode = cfg.attackPath or "auto"
    if mode ~= "auto" then return mode end
    if Path.locked then return Path.locked end
    return Path.order[Path.index] or "gui"
end

function Path.advance()
    Path.index = (Path.index % #Path.order) + 1
end

function Path.note(name, confirmed)
    local counter = Path.counters[name]
    if not counter then counter = { swings = 0, hits = 0 }; Path.counters[name] = counter end
    if confirmed then
        counter.hits = counter.hits + 1
        if cfg.attackPath == "auto" then
            Path.locked = name
            Path.testAt = (S.swings or 0) + 50
            Path.msg = "locked " .. tostring(name)
        end
    end
    counter.swings = counter.swings + 1
end

function Path.retest()
    if cfg.attackPath ~= "auto" or not Path.locked then return end
    if (S.swings or 0) >= (Path.testAt or 0) then
        Path.locked, Path.index, Path.msg = nil, 1, "re-testing"
    end
end

function Path.summary()
    local parts = {}
    for _, name in ipairs(Path.order) do
        local counter = Path.counters[name] or { swings = 0, hits = 0 }
        parts[#parts + 1] = string.format("%s %d/%d", name, counter.hits or 0, counter.swings or 0)
    end
    return table.concat(parts, "  ")
end

-- A no-hit swing only means something when the swing could actually land.
-- Failed HUD reads (gas nil), a dead player, broken blades, an out-of-reach
-- target or a refill must never drive the watchdog.
function Path.nohitEligible()
    if not S.running or S.refilling or S.results then return false end
    local target = S.target
    if not target or not target.model or dead(target.model) then return false end
    local humanoid = target.model:FindFirstChildOfClass("Humanoid")
    if not humanoid or (tonumber(humanoid.Health) or 0) <= 0 then return false end
    local _, root, ownHumanoid = myChar()
    if not root or not ownHumanoid or (tonumber(ownHumanoid.Health) or 0) <= 0 then return false end
    if S.bladesBroken then return false end
    local gas = tonumber(S.gas)
    if not gas or gas <= 0 then return false end
    local hrp = target.model:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local okDist, distance = pcall(function() return (hrp.Position - root.Position).Magnitude end)
    if not okDist or not distance then return false end
    return distance <= (S.hoverNow or cfg.hover or 120) + 45
end

Path.reset()
--============================================================================
local napeStock = {}

local function remember(part)
    local entry = napeStock[part]
    if not entry then
        entry = { size = part.Size }
        napeStock[part] = entry
    end
    return entry
end

local function applyNapes()
    if not cfg.napeEnabled then
        S.napeParts = 0
        S.pullMethod = "off"
        S.pullMsg = "disabled by the Pin nape toggle"
        S.pullRan = false
        return 0
    end
    if cfg.pullDetach == "unparent" and S.pullBlockedUntil and clock() < S.pullBlockedUntil then
        S.napeParts = 0
        S.pullMethod = "wait"
        S.pullMsg = string.format("drift lockout: %.1fs left", math.max(0, S.pullBlockedUntil - clock()))
        S.pullRan = false
        return 0
    end
    local target = S.target
    if not target then
        S.napeParts = 0
        S.pullMethod = "off"
        S.pullMsg = "no target"
        S.pullRan = false
        return 0
    end
    local _, root = myChar()
    if not root then
        S.napeParts = 0
        S.pullMethod = "off"
        S.pullMsg = "no character root"
        S.pullRan = false
        return 0
    end
    local folder = workspace:FindFirstChild("Titans")
    if not folder then
        S.napeParts = 0
        S.pullMethod = "off"
        S.pullMsg = "workspace.Titans missing"
        S.pullRan = false
        return 0
    end
    S.pullRan = false
    local playerPos = root.Position
    -- REFERENCE: Nape.CFrame = playerHRP.CFrame * CFrame.new(0, NapeOffsetY, 0)
    local dest = root.CFrame * CFrame.new(0, cfg.magnetY or 2, 0)
    local cube = cfg.magnetSize or 15
    local want = Vector3.new(cube, cube, cube)
    local placed = 0

    local function pull(model, isTarget)
        if not model or model == localChar() or model.Parent ~= folder then
            if isTarget then S.pullMethod, S.pullMsg = "off", "target model is gone" end
            return false
        end
        local humanoid = model:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then
            if isTarget then S.pullMethod, S.pullMsg = "off", "target has no live Humanoid" end
            return false
        end
        local nape = napeOf(model)
        if not nape or not nape.Parent or nape.Parent.Name ~= "Hit" then
            if isTarget then S.pullMethod, S.pullMsg = "off", "nape missing (Hit.Nape)" end
            return false
        end
        local hrp = model:FindFirstChild("HumanoidRootPart")
        if hrp then
            local ok, far = pcall(function() return (hrp.Position - playerPos).Magnitude > 600 end)
            if ok and far then
                if isTarget then S.pullMethod, S.pullMsg = "off", "target beyond 600 studs" end
                return false
            end
        end

        -- Internal BasePart.CFrame writes move the whole welded assembly, so the
        -- nape has to be detached first or the titan follows it. REFERENCE's
        -- raw memory write moved only the part; this is the internal equivalent.
        local function reattach(entry, restoreSize)
            local record = entry and entry.detached
            if not record then return end
            entry.detached = nil
            local part = record.nape
            local anchored = false
            for _, item in ipairs(record.joints) do
                local joint, other, offset, enabled = item[1], item[2], item[3], item[4]
                local parent, unparented = item[5], item[6]
                if joint then
                    if not anchored and part and part.Parent and other and other.Parent then
                        pcall(function() part.CFrame = other.CFrame * offset end)
                        anchored = true
                    end
                    if unparented and parent then
                        pcall(function() joint.Parent = parent end)
                    end
                    pcall(function() joint.Enabled = enabled end)
                    if enabled then S.jointsOn = (S.jointsOn or 0) + 1 end
                end
            end
            if restoreSize and part and part.Parent and record.size then
                pcall(function() part.Size = record.size end)
            end
            if part and part.Parent and record.canCollide ~= nil then
                pcall(function() part.CanCollide = record.canCollide end)
            end
            S.jointsOff = math.max(0, (S.jointsOff or 0) - (record.disabled or #record.joints))
        end

        local function jointsOf(targetModel, part)
            local list = {}
            local ok, joints = pcall(function() return part:GetJoints() end)
            if ok and type(joints) == "table" then
                for _, joint in ipairs(joints) do list[#list + 1] = joint end
            end
            if #list == 0 and targetModel then
                for _, descendant in ipairs(targetModel:GetDescendants()) do
                    if descendant:IsA("JointInstance") or descendant:IsA("WeldConstraint") then
                        local okParts, part0, part1 = pcall(function() return descendant.Part0, descendant.Part1 end)
                        if okParts and (part0 == part or part1 == part) then list[#list + 1] = descendant end
                    end
                end
            end
            return list
        end

        -- No joint means the nape cannot be moved without risking the titan:
        -- never write its CFrame. Fire the blade's Touched instead.
        local function touchedSwing(part)
            local char = localChar()
            if not char then return false end
            local fired = 0
            for _, blade in ipairs(char:GetDescendants()) do
                if blade:IsA("BasePart") and caps.getconnections then
                    local ok, connections = pcall(getconnections, blade.Touched)
                    if ok and type(connections) == "table" then
                        for _, connection in ipairs(connections) do
                            if pcall(function() connection:Fire(part) end) then fired = fired + 1 end
                        end
                    end
                end
            end
            if fired == 0 and type(firetouchinterest) == "function" then
                for _, blade in ipairs(char:GetDescendants()) do
                    if blade:IsA("BasePart") then
                        pcall(firetouchinterest, blade, part, 0)
                        pcall(firetouchinterest, blade, part, 1)
                        fired = fired + 1
                    end
                end
            end
            S.pullMsg = fired > 0
                and ("no joint - fired " .. fired .. " Touched connection(s)")
                or "no joint and no Touched handler"
            S.pullRan = fired > 0
            S.state = S.pullMsg
            return fired > 0
        end

        local entry = remember(nape)
        if entry.detached then reattach(entry, false) end

        local mode = (cfg.pullDetach == "unparent") and "unparent" or "disable"
        local record = { nape = nape, model = model, joints = {}, size = entry.size, at = clock(), mode = mode }
        for _, joint in ipairs(jointsOf(model, nape)) do
            local okParts, part0, part1 = pcall(function() return joint.Part0, joint.Part1 end)
            if okParts then
                local other = (part0 == nape) and part1 or part0
                if other and other ~= nape then
                    local enabled = true
                    pcall(function() enabled = joint.Enabled end)
                    local okOffset, offset = pcall(function() return other.CFrame:ToObjectSpace(nape.CFrame) end)
                    if okOffset and offset then
                        record.joints[#record.joints + 1] = {
                            joint, other, offset, enabled, joint.Parent, false,
                        }
                    end
                end
            end
        end

        if #record.joints == 0 then
            S.pullMethod = "touched"
            return touchedSwing(nape)
        end

        -- Default (pullDetach="disable") is the pre-patch path: Enabled=false,
        -- write the CFrame in this same frame, no collision change, no wait.
        -- pullDetach="unparent" is the experimental anti-drag path.
        local disabled = 0
        for _, item in ipairs(record.joints) do
            local joint = item[1]
            local detached = pcall(function() joint.Enabled = false end)
            if mode == "unparent" and (joint:IsA("Weld") or joint:IsA("WeldConstraint")) then
                local okParent = pcall(function() joint.Parent = nil end)
                item[6] = okParent
                if okParent then detached = true end
            end
            if detached then disabled = disabled + 1 end
        end
        record.disabled = disabled
        S.jointsOff = (S.jointsOff or 0) + disabled
        entry.detached, entry.reattach = record, reattach

        if mode == "unparent" and disabled < #record.joints then
            for _, item in ipairs(record.joints) do
                local joint = item[1]
                if item[5] then pcall(function() joint.Parent = item[5] end) end
                pcall(function() joint.Enabled = item[4] end)
            end
            S.jointsOff = math.max(0, (S.jointsOff or 0) - disabled)
            entry.detached = nil
            S.pullMethod = "blocked"
            S.pullMsg = string.format("unparent blocked: %d/%d joints detached", disabled, #record.joints)
            S.pullRan = false
            S.state = S.pullMsg
            return false
        end

        if (tonumber(cfg.pullWait) or 0) >= 1 then
            S.pullMethod = "wait"
            S.pullMsg = "waiting one physics frame after detach"
            S.pullRan = false
            task.wait()
            if entry.detached ~= record or not S.running or dead(model)
                or not nape.Parent or not root.Parent then
                pcall(reattach, entry, true)
                S.pullMethod = "blocked"
                S.pullMsg = "aborted while waiting for detach"
                S.pullRan = false
                return false
            end
            record.at = clock()
        end

        if cfg.pullNoCollide then
            local canCollide = true
            pcall(function() canCollide = nape.CanCollide end)
            record.canCollide = canCollide
            pcall(function() nape.CanCollide = false end)
        end

        dest = root.CFrame * CFrame.new(0, cfg.magnetY or 2, 0)
        local before = hrp and hrp.Position
        local okMove = pcall(function() nape.CFrame = dest end)
        local after = hrp and hrp.Position
        if not okMove then
            reattach(entry, true)
            S.pullMethod = "blocked"
            S.pullMsg = "nape CFrame write failed"
            S.pullRan = false
            return false
        end

        local drift = 0
        if before and after then
            drift = (after - before).Magnitude
            S.drift = math.max(S.drift or 0, drift)
            S.lastDrift = drift
        end
        if drift > 3 then
            S.pullMethod = "drift"
            S.pullMsg = string.format("titan moved %.1f studs during pull", drift)
            if mode == "unparent" then
                reattach(entry, true)
                if isTarget then
                    S.pullStrikes = (S.pullStrikes or 0) + 1
                    if S.pullStrikes >= 3 then
                        cfg.napeEnabled = false
                        pcall(refreshControls)
                        S.pullMethod = "off"
                        S.pullMsg = string.format("PIN OFF - titan moved %.1f studs", drift)
                    else
                        S.pullBlockedUntil = clock() + 5
                    end
                end
                S.pullRan = false
                S.state = S.pullMsg
                return false
            end
            -- Default path keeps the nape on the player for this swing even if
            -- the pre-patch detach dragged the titan. The timer reattaches it.
        elseif isTarget then
            S.pullStrikes = 0
        end

        -- Size once per instance: the game keeps it and Size writes are heavy.
        if entry.pullSize ~= cube then
            pcall(function() nape.Size = want end)
            entry.pullSize = cube
        end
        S.pullMethod = (drift > 3) and "drift" or "ran"
        S.pullRan = true
        if drift <= 3 then S.pullMsg = nil end
        S.pulls = (S.pulls or 0) + 1
        placed = placed + 1

        -- Re-attach after the slash. WeldConstraint re-welds at the CURRENT
        -- offset when enabled, so the nape goes back to its saved offset while
        -- still detached; only then are the joints enabled again.
        task.delay(0.22, function()
            if entry.detached == record then pcall(reattach, entry, false) end
        end)
        return true
    end

    pull(target.model, true)

    -- Pin All Napes: the nearest napeMult-1 live titans, every other slash,
    -- one frame apart. One blade swing caps at about 6 titans in this game.
    local extras = cfg.magnet and math.max(0, math.min(5, (cfg.napeMult or 6) - 1)) or 0
    if extras > 0 then
        S.pullSlash = (S.pullSlash or 0) + 1
        if S.pullSlash % 2 == 0 then
            local targetHrp = target.model:FindFirstChild("HumanoidRootPart")
            local anchor = targetHrp and targetHrp.Position or playerPos
            local candidates = {}
            for _, model in ipairs(folder:GetChildren()) do
                if model ~= target.model and model:IsA("Model") and not dead(model) then
                    local hrp = model:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        local ok, distance = pcall(function() return (hrp.Position - anchor).Magnitude end)
                        if ok and distance and distance <= (cfg.napeRange or 900) then
                            candidates[#candidates + 1] = { model = model, d = distance }
                        end
                    end
                end
            end
            table.sort(candidates, function(a, b) return a.d < b.d end)
            for index = 1, math.min(#candidates, extras) do
                task.wait()
                if not S.running then break end
                pull(candidates[index].model, false)
            end
        end
    end
    S.napeParts = placed
    S.cluster = placed
    return placed
end

local function restoreNapes()
    Pin.stop(nil)
    local restored = 0
    for part, entry in pairs(napeStock) do
        if entry.detached and entry.reattach then pcall(entry.reattach, entry, false) end
        if part and part.Parent then
            if pcall(function() part.Size = entry.size end) then restored = restored + 1 end
        end
        napeStock[part] = nil
    end
    S.napeParts = 0
    S.jointsOff = 0
    return restored
end

local function pruneNapes()
    local now = clock()
    for part, entry in pairs(napeStock) do
        local record = entry.detached
        -- Detached napes reattach on their own after 0.22s; this catches ones
        -- whose timer could not run (titan death, target switch, error).
        local stale = record and (now - (record.at or now) > 0.6 or dead(record.model))
        if part == nil or part.Parent == nil or stale then
            if record and entry.reattach then pcall(entry.reattach, entry, false) end
            if part == nil or part.Parent == nil then napeStock[part] = nil end
        end
    end
end
--============================================================================
local Hover = { base = nil, goal = nil, face = nil, conn = nil, phase = 0, wasOwner = false }

local function setOwner(name)
    S.owner = name
    if name ~= "farm" then
        Hover.goal, Hover.base = nil, nil
    end
end

local function hoverStep(dt)
    local _, root, humanoid = myChar()
    if not S.running or S.owner ~= "farm" or not Hover.base then
        Hover.goal = nil
        if Hover.wasOwner then
            if root then pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end) end
            Hover.wasOwner = false
        end
        return
    end
    if not root then Hover.wasOwner = false return end
    if S.results or S.refilling or S.reloading or (humanoid and humanoid.Health <= 0) then
        pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        Hover.wasOwner, Hover.goal = false, nil
        return
    end
    Hover.wasOwner = true
    local step = math.clamp(dt or 0, 0, 0.1)
    Hover.phase = (Hover.phase or 0) + step * (cfg.bobHz or 1.5) * 6.28318
    local bob = math.sin(Hover.phase) * (cfg.bobAmp or 2)
    local goal = Hover.base + Vector3.new(0, bob, 0)
    Hover.goal = goal

    local rotation = root.CFrame.Rotation
    local look = rotation.LookVector
    local flatLook = Vector3.new(look.X, 0, look.Z)
    if flatLook.Magnitude > 0.01 then
        rotation = CFrame.lookAt(Vector3.zero, flatLook)
    end
    local face = Hover.face
    if face then
        local dx, dz = face.X - goal.X, face.Z - goal.Z
        if dx * dx + dz * dz > 4 then
            rotation = CFrame.lookAt(Vector3.zero, Vector3.new(dx, 0, dz))
        end
    end

    pcall(function()
        root.CFrame = CFrame.new(goal) * rotation
        local velocity = root.AssemblyLinearVelocity
        if cfg.zeroVelocity then
            if S.swingBoostUntil and clock() < S.swingBoostUntil then
                root.AssemblyLinearVelocity = Vector3.new(velocity.X, 0, velocity.Z)
            else
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
        else
            local limit = tonumber(cfg.fallLimit) or 0
            if limit > 0 and velocity.Y < -limit then
                root.AssemblyLinearVelocity = Vector3.new(velocity.X, -limit, velocity.Z)
            end
            local cap = tonumber(cfg.speedCap) or 800
            local current = root.AssemblyLinearVelocity
            if cap > 0 and current.Magnitude > cap then
                root.AssemblyLinearVelocity = current.Unit * cap
            end
        end
    end)
end

local function hoverLoop()
    if Hover.conn then return end
    Hover.conn = RunService.Heartbeat:Connect(safe(function(dt)
        pcall(hoverStep, dt)
    end, "connect"))
end

local function hoverStop()
    if Hover.conn then pcall(function() Hover.conn:Disconnect() end) end
    local _, root = myChar()
    if root then pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end) end
    Hover.conn = nil
    Hover.goal, Hover.base, Hover.face = nil, nil, nil
    Hover.wasOwner = false
    S.owner = nil
    S.swingBoostUntil = nil
end

local function hoverAt(root, point, height)
    local base = Vector3.new(point.X, point.Y + height, point.Z)
    -- Keep the bob phase while the base stays on the same titan; reset only on
    -- the first write or a far target switch.
    if not Hover.base or (Hover.base - base).Magnitude > 50 then
        Hover.phase = 0
    end
    S.owner = "farm"
    Hover.base = base
    Hover.face = point
    Hover.goal = base
    hoverLoop()
end

local function aimAt(root, camera, point)
    -- Camera CFrame writes are intentionally disabled. Forcing the camera
    -- fights Roblox's default camera controller and causes the rare
    -- camera/FOV snap. The farm does not need the camera to be aimed.
    return
end

local function travel(point)
    local _, root = myChar()
    if not root then return false end
    S.owner = "farm"
    Hover.base = point
    Hover.face = nil
    local hrp = S.target and S.target.model
        and S.target.model:FindFirstChild("HumanoidRootPart")
    if hrp then Hover.face = hrp.Position end
    Hover.goal = point
    hoverLoop()
    return true
end
